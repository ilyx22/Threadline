{
  "keyframes": [
    {
      "name": "tl-fade-in",
      "frames": [
        "0% { opacity: 0; }",
        "100% { opacity: 1; }"
      ]
    },
    {
      "name": "tl-rise",
      "frames": [
        "0% { opacity: 0; transform: translateY(6px); }",
        "100% { opacity: 1; transform: translateY(0px); }"
      ]
    },
    {
      "name": "tl-scale-in",
      "frames": [
        "0% { opacity: 0; transform: scale(0.97); }",
        "100% { opacity: 1; transform: scale(1); }"
      ]
    },
    {
      "name": "tl-slide-from-right",
      "frames": [
        "0% { transform: translate(100%); }",
        "100% { transform: translate(0px); }"
      ]
    },
    {
      "name": "tl-shimmer",
      "frames": [
        "100% { transform: translate(100%); }"
      ]
    },
    {
      "name": "tl-pulse-soft",
      "frames": [
        "0%, 100% { opacity: 1; }",
        "50% { opacity: 0.45; }"
      ]
    },
    {
      "name": "tl-draw",
      "frames": [
        "0% { stroke-dashoffset: var(--dash,1000); }",
        "100% { stroke-dashoffset: 0; }"
      ]
    },
    {
      "name": "spin",
      "frames": [
        "100% { transform: rotate(1turn); }"
      ]
    },
    {
      "name": "tl-belt",
      "frames": [
        "100% { background-position-x: -48px; }"
      ]
    },
    {
      "name": "tl-stamp-in",
      "frames": [
        "0% { transform: rotate(-3deg) scale(1.6); opacity: 0; }",
        "60% { transform: rotate(-3deg) scale(0.94); opacity: 1; }",
        "100% { transform: rotate(-3deg) scale(1); opacity: 1; }"
      ]
    },
    {
      "name": "tl-pulse-travel",
      "frames": [
        "0% { offset-distance: 0px; opacity: 0; }",
        "8% { opacity: 1; }",
        "92% { opacity: 1; }",
        "100% { offset-distance: 100%; opacity: 0; }"
      ]
    },
    {
      "name": "tl-blink",
      "frames": [
        "0%, 100% { opacity: 1; }",
        "50% { opacity: 0.35; }"
      ]
    },
    {
      "name": "tl-bob",
      "frames": [
        "0%, 100% { transform: translateY(0px); }",
        "50% { transform: translateY(-3px); }"
      ]
    }
  ],
