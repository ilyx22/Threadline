        "lineHeight": "27.2px",
        "letterSpacing": "normal",
        "textTransform": "none",
        "color": "rgb(31, 29, 26)",
        "fontStyle": "normal"
      }
    },
    {
      "tag": "p",
      "text": "A small number of clients at a time. Applications are read by a person and answered either",
      "rect": {
        "x": 20,
        "y": 508,
        "w": 448,
        "h": 46
      },
      "style": {
        "fontFamily": "Inter, \"Inter Fallback\", ui-sans-serif, system-ui, sans-serif",
        "fontSize": "14px",
        "fontWeight": "400",
        "lineHeight": "22.75px",
        "letterSpacing": "normal",
        "textTransform": "none",
        "color": "rgb(126, 119, 108)",
        "fontStyle": "normal"
      }
    },
    {
      "tag": "p",
      "text": "THE PROBLEM",
      "rect": {
        "x": 20,
        "y": 1071,
        "w": 728,
        "h": 12
