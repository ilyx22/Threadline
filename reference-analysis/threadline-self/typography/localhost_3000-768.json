        "textTransform": "none",
        "color": "rgb(31, 29, 26)",
        "fontStyle": "normal"
      }
    },
    {
      "tag": "h2",
      "text": "Expertise goes in one end. Content worth watching comes out the other.",
      "rect": {
        "x": 20,
        "y": 3485,
        "w": 371,
        "h": 106
      },
      "style": {
        "fontFamily": "Fraunces, \"Fraunces Fallback\", \"Iowan Old Style\", Georgia, serif",
