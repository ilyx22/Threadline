        "textTransform": "none",
        "color": "rgb(79, 74, 66)",
        "fontStyle": "normal"
      }
    },
    {
      "tag": "p",
      "text": "You talk. You record. You approve. You sell. Threadline handles the machine.",
      "rect": {
        "x": 20,
        "y": 364,
        "w": 728,
        "h": 27
      },
      "style": {
