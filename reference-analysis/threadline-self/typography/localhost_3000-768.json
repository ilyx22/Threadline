        "color": "rgb(31, 29, 26)",
        "fontStyle": "normal"
      }
    },
    {
      "tag": "h2",
      "text": "You do four things. Threadline handles the machine.",
      "rect": {
        "x": 20,
        "y": 2330,
        "w": 371,
        "h": 106
      },
      "style": {
        "fontFamily": "Fraunces, \"Fraunces Fallback\", \"Iowan Old Style\", Georgia, serif",
