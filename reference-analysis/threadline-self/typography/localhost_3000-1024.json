        "fontWeight": "400",
        "lineHeight": "22.75px",
        "letterSpacing": "normal",
        "textTransform": "none",
        "color": "rgb(126, 119, 108)",
        "fontStyle": "normal"
      }
    },
    {
      "tag": "p",
      "text": "THE PROBLEM",
      "rect": {
        "x": 32,
        "y": 847,
        "w": 460,
        "h": 12
