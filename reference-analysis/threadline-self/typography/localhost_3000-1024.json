        "textTransform": "none",
        "color": "rgb(79, 74, 66)",
        "fontStyle": "normal"
      }
    },
    {
      "tag": "p",
      "text": "You talk. You record. You approve. You sell. Threadline handles the machine.",
      "rect": {
        "x": 32,
        "y": 447,
        "w": 467,
        "h": 54
      },
      "style": {
