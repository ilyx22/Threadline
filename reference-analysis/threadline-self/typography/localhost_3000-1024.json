        "lineHeight": "27.2px",
        "letterSpacing": "normal",
        "textTransform": "none",
        "color": "rgb(31, 29, 26)",
        "fontStyle": "normal"
      }
    },
    {
      "tag": "p",
      "text": "A small number of clients at a time. Applications are read by a person and answered either",
      "rect": {
        "x": 32,
        "y": 617,
        "w": 448,
        "h": 46
      },
      "style": {
        "fontFamily": "Inter, \"Inter Fallback\", ui-sans-serif, system-ui, sans-serif",
