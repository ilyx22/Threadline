        "textTransform": "none",
        "color": "rgb(31, 29, 26)",
        "fontStyle": "normal"
      }
    },
    {
      "tag": "h2",
      "text": "Most agencies stop at publish. The machine turns round.",
      "rect": {
        "x": 32,
        "y": 3699,
        "w": 446,
        "h": 128
      },
      "style": {
        "fontFamily": "Fraunces, \"Fraunces Fallback\", \"Iowan Old Style\", Georgia, serif",
