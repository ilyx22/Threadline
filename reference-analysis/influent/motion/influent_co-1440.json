{
  "keyframes": [
    {
      "name": "marquee",
      "frames": [
        "0% { transform: translate(0px); }",
        "100% { transform: translate(-50%); }"
      ]
    },
    {
      "name": "pulse",
      "frames": [
        "50% { opacity: 0.5; }"
      ]
    },
    {
      "name": "spin",
      "frames": [
        "100% { transform: rotate(360deg); }"
      ]
    },
    {
      "name": "enter",
      "frames": [
        "0% { opacity: var(--tw-enter-opacity, 1); transform: translate3d(var(--tw-enter-translate-x, 0),var(--tw-enter-translate-y, 0),0) scale3d(var(--tw-enter-scale, 1),va }"
      ]
    },
    {
      "name": "exit",
      "frames": [
        "100% { opacity: var(--tw-exit-opacity, 1); transform: translate3d(var(--tw-exit-translate-x, 0),var(--tw-exit-translate-y, 0),0) scale3d(var(--tw-exit-scale, 1),var(-- }"
      ]
    },
    {
      "name": "float",
      "frames": [
        "0%, 100% { transform: translateY(0px); }",
        "50% { transform: translateY(-6px); }"
      ]
    },
    {
      "name": "pulse-glow",
      "frames": [
        "0%, 100% { opacity: 0.3; }",
        "50% { opacity: 0.7; }"
      ]
    },
    {
      "name": "flow-dash",
      "frames": [
        "100% { stroke-dashoffset: -40; }"
      ]
    },
    {
      "name": "particle-drift",
      "frames": [
        "0% { offset-distance: 0%; opacity: 0; }",
        "10% { opacity: 1; }",
        "90% { opacity: 1; }",
        "100% { offset-distance: 100%; opacity: 0; }"
      ]
    },
    {
      "name": "active-pulse",
      "frames": [
        "0%, 100% { box-shadow: rgba(244, 123, 37, 0.5) 0px 0px 0px 2px, rgba(244, 123, 37, 0.2) 0px 0px 10px; }",
        "50% { box-shadow: rgba(244, 123, 37, 0.8) 0px 0px 0px 3px, rgba(244, 123, 37, 0.4) 0px 0px 18px; }"
      ]
    },
    {
      "name": "satellite-drift",
      "frames": [
        "0%, 100% { transform: translate(0px); }",
        "25% { transform: translate(3px, -5px); }",
        "50% { transform: translate(-2px, -8px); }",
        "75% { transform: translate(4px, -3px); }"
      ]
    },
    {
      "name": "metrics-chevron-invite",
      "frames": [
        "0%, 78%, 100% { transform: translateY(0px); }",
        "84% { transform: translateY(-1px); }",
        "89% { transform: translateY(-2px); }",
        "94% { transform: translateY(-1px); }"
      ]
    },
    {
      "name": "shimmer-sweep",
      "frames": [
        "0%, 100% { background-position: 200% 0px; }",
        "50% { background-position: -200% 0px; }"
      ]
    },
    {
      "name": "galaxy-shift",
      "frames": [
        "0%, 100% { background-position: 0% 50%; }",
        "50% { background-position: 100% 50%; }"
      ]
    },
    {
      "name": "galaxy-glow",
      "frames": [
        "0%, 100% { filter: drop-shadow(rgba(58, 68, 120, 0.18) 0px 0px 6px) drop-shadow(rgba(54, 69, 99, 0.1) 0px 0px 14px); }",
        "50% { filter: drop-shadow(rgba(79, 58, 120, 0.2) 0px 0px 7px) drop-shadow(rgba(54, 61, 99, 0.12) 0px 0px 16px); }"
      ]
    },
    {
      "name": "alien-blink",
      "frames": [
        "0%, 97.35%, 100% { opacity: 0; }",
        "98%, 99.3% { opacity: 1; }"
      ]
    },
    {
      "name": "chasm-spin",
      "frames": [
        "0% { transform: rotate(0deg); }",
        "100% { transform: rotate(360deg); }"
      ]
    },
    {
      "name": "chasm-drift",
      "frames": [
        "0%, 100% { transform: translate(0px); }",
        "50% { transform: translate(6px, 5px); }"
      ]
    },
    {
      "name": "accordion-up",
      "frames": [
        "0% { height: var(--radix-accordion-content-height); }",
        "100% { height: 0px; }"
      ]
    },
    {
      "name": "accordion-down",
      "frames": [
        "0% { height: 0px; }",
        "100% { height: var(--radix-accordion-content-height); }"
      ]
    },
    {
      "name": "swipe-out-left",
      "frames": [
        "0% { transform: var(--y) translate(var(--swipe-amount-x)); opacity: 1; }",
        "100% { transform: var(--y) translate(calc(var(--swipe-amount-x) - 100%)); opacity: 0; }"
      ]
    },
    {
      "name": "swipe-out-right",
      "frames": [
        "0% { transform: var(--y) translate(var(--swipe-amount-x)); opacity: 1; }",
        "100% { transform: var(--y) translate(calc(var(--swipe-amount-x) + 100%)); opacity: 0; }"
      ]
    },
    {
      "name": "swipe-out-up",
      "frames": [
        "0% { transform: var(--y) translateY(var(--swipe-amount-y)); opacity: 1; }",
        "100% { transform: var(--y) translateY(calc(var(--swipe-amount-y) - 100%)); opacity: 0; }"
      ]
    },
    {
      "name": "swipe-out-down",
      "frames": [
        "0% { transform: var(--y) translateY(var(--swipe-amount-y)); opacity: 1; }",
        "100% { transform: var(--y) translateY(calc(var(--swipe-amount-y) + 100%)); opacity: 0; }"
      ]
    },
    {
      "name": "sonner-fade-in",
      "frames": [
        "0% { opacity: 0; transform: scale(0.8); }",
        "100% { opacity: 1; transform: scale(1); }"
      ]
    },
    {
      "name": "sonner-fade-out",
      "frames": [
        "0% { opacity: 1; transform: scale(1); }",
        "100% { opacity: 0; transform: scale(0.8); }"
      ]
    },
    {
      "name": "sonner-spin",
      "frames": [
        "0% { opacity: 1; }",
        "100% { opacity: 0.15; }"
      ]
    }
  ],
