{
  "keyframes": [
    {
      "name": "marquee",
      "frames": [
        "100% { transform: translate(-50%); }"
      ]
    },
    {
      "name": "glyph-flow",
      "frames": [
        "0% { offset-distance: 0%; opacity: 0; }",
        "8%, 88% { opacity: 1; }",
        "100% { offset-distance: 100%; opacity: 0; }"
      ]
    },
    {
      "name": "glyph-station",
      "frames": [
        "0%, 12% { filter: none; }",
        "4% { filter: brightness(1.14); }"
      ]
    },
    {
      "name": "glyph-return",
      "frames": [
        "100% { stroke-dashoffset: -12px; }"
      ]
    },
    {
      "name": "glyph-draw",
      "frames": [
        "100% { stroke-dashoffset: 0; }"
      ]
    },
    {
      "name": "glyph-band",
      "frames": [
        "100% { opacity: 1; }"
      ]
    }
  ],
