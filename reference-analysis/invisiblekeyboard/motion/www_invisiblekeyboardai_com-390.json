{
  "keyframes": [
    {
      "name": "spin",
      "frames": [
        "100% { transform: rotate(360deg); }"
      ]
    },
    {
      "name": "pulse",
      "frames": [
        "50% { opacity: 0.5; }"
      ]
    },
    {
      "name": "enter",
      "frames": [
        "0% { opacity: var(--tw-enter-opacity,1); transform: translate3d(var(--tw-enter-translate-x,0),var(--tw-enter-translate-y,0),0)scale3d(var(--tw-enter-scale,1),var(--t }"
      ]
    },
    {
      "name": "exit",
      "frames": [
        "100% { opacity: var(--tw-exit-opacity,1); transform: translate3d(var(--tw-exit-translate-x,0),var(--tw-exit-translate-y,0),0)scale3d(var(--tw-exit-scale,1),var(--tw-ex }"
      ]
    },
    {
      "name": "accordion-down",
      "frames": [
        "0% { height: 0px; }",
        "100% { height: var(--radix-accordion-content-height,var(--bits-accordion-content-height,var(--reka-accordion-content-height,var(--kb-accordion-content-height,var(--ngp }"
      ]
    },
    {
      "name": "accordion-up",
      "frames": [
        "0% { height: var(--radix-accordion-content-height,var(--bits-accordion-content-height,var(--reka-accordion-content-height,var(--kb-accordion-content-height,var(--ngp }",
        "100% { height: 0px; }"
      ]
    },
    {
      "name": "caret-blink",
      "frames": [
        "0%, 70%, 100% { opacity: 1; }",
        "20%, 50% { opacity: 0; }"
      ]
    },
    {
      "name": "swipe-out-left",
      "frames": [
        "0% { transform: var(--y) translateX(var(--swipe-amount-x)); opacity: 1; }",
        "100% { transform: var(--y) translateX(calc(var(--swipe-amount-x) - 100%)); opacity: 0; }"
      ]
    },
    {
      "name": "swipe-out-right",
      "frames": [
        "0% { transform: var(--y) translateX(var(--swipe-amount-x)); opacity: 1; }",
        "100% { transform: var(--y) translateX(calc(var(--swipe-amount-x) + 100%)); opacity: 0; }"
      ]
    },
    {
      "name": "swipe-out-up",
      "frames": [
        "0% { transform: var(--y) translateY(var(--swipe-amount-y)); opacity: 1; }",
        "100% { transform: var(--y) translateY(calc(var(--swipe-amount-y) - 100%)); opacity: 0; }"
      ]
    },
    {
      "name": "swipe-out-down",
      "frames": [
        "0% { transform: var(--y) translateY(var(--swipe-amount-y)); opacity: 1; }",
        "100% { transform: var(--y) translateY(calc(var(--swipe-amount-y) + 100%)); opacity: 0; }"
      ]
    },
    {
      "name": "sonner-fade-in",
      "frames": [
        "0% { opacity: 0; transform: scale(0.8); }",
        "100% { opacity: 1; transform: scale(1); }"
      ]
    },
    {
      "name": "sonner-fade-out",
      "frames": [
        "0% { opacity: 1; transform: scale(1); }",
        "100% { opacity: 0; transform: scale(0.8); }"
      ]
    },
    {
      "name": "sonner-spin",
      "frames": [
        "0% { opacity: 1; }",
        "100% { opacity: 0.15; }"
      ]
    }
  ],
  "animated": [
    {
      "tag": "button",
      "cls": "absolute inset-0 bg-ink/60 backdrop-blur-sm animate-in fade-",
      "name": "enter",
      "duration": "0.3s",
      "timing": "ease",
      "iteration": "1",
      "delay": "0s"
    },
    {
      "tag": "div",
      "cls": "relative w-full max-w-lg bg-paper text-ink border border-rul",
      "name": "enter",
      "duration": "0.3s",
      "timing": "ease",
      "iteration": "1",
      "delay": "0s"
    }
  ],
  "easings": [
    [
      "cubic-bezier(0.4, 0, 0.2, 1) 0.15s",
      25
    ],
    [
      "ease 0.3s",
      2
    ]
  ]
}