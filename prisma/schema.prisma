/// Threadline's own business metrics (internal portal only, not tenant data).
model InternalMetric {
  id                  String   @id @default(cuid())
  periodStart         DateTime @unique
  leadsBySource       String   @default("{}") // JSON Record<string, number>
  salesCalls          Int      @default(0)
  showRatePct         Float    @default(0)
  closeRatePct        Float    @default(0)
  cashCollectedMinor  Int      @default(0)
  setupFeesMinor      Int      @default(0)
  mrrMinor            Int      @default(0)
  implementationHours Float    @default(0)
  supportHours        Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Threadline's own commercial operations — the Living SOP Engine
// ---------------------------------------------------------------------------
//
// Everything below is Threadline's own business, not a client's. Like
// `Application` and `InternalMetric`, these models deliberately have no `orgId`:
// they are not tenant data, they are never readable from a client workspace, and
// the capability that guards them is denied to every client role.
//
// TWO BOUNDARIES ARE DELIBERATE AND SHOULD BE PRESERVED:
//
//   1. **This is not a CRM.** An external CRM owns contacts, companies,
//      communications, deal history and broad pipeline. These models own the
//      proprietary part: given the state a record is in, what exactly happens
//      next. The link between the two is three columns — provider, record id,
//      record url — and no synchronisation. Duplicating a CRM here would mean
//      maintaining a worse one.
//   2. **No channel is encoded anywhere.** `Prospect.channel` is free text
//      because which channel carries a first touch is an operating decision,
//      not an architectural one. The state machine and the arithmetic are
//      identical either way.
//
// The invariant "no active record without a next action and a due date" lives in
// src/lib/domain/sop.ts rather than in a database constraint: "active" is a
// property of the state rather than of the row, and a conditional NOT NULL would
// need a trigger maintained in two SQL dialects. It is enforced on every write
// and covered by tests.

/// One candidate market wedge and the expensive problem being claimed for it.
///
/// "Expert-led B2B" is the umbrella category. This is the specific segment
/// currently being sold against, held as a record precisely because it is a
/// belief that changes on evidence.
model MarketWedge {
  id              String    @id @default(cuid())
  label           String
  state           String    @default("candidate") // candidate | immersion | interviews | commercial_test | validated | revised
  /// True for the single wedge currently being sold against.
  active          Boolean   @default(false)
  summary         String? // exactly who this is
  problem         String? // the expensive recurring problem, in their language
  outcome         String? // the outcome hypothesis
  qualification   String? // what must already be true for them to succeed here
  mechanism       String?
  // Candidate scoring, 0-5. Used to choose between wedges, not to prove one.
  scoreEconomics  Int       @default(0)
  scorePain       Int       @default(0)
  scoreReach      Int       @default(0)
  scorePrecedent  Int       @default(0)
  notes           String?
  /// Set when the hypothesis was frozen for a controlled sales sample.
  frozenAt        DateTime?
  ownerId         String?
  nextAction      String?
  nextActionDueAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner         User?                    @relation("WedgeOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  checks        SopCheck[]
  conversations ValidationConversation[]
  prospects     Prospect[]
  examples      ResearchExample[]

  @@index([state])
  @@index([active])
}

/// One research conversation. Not a disguised sales call.
///
/// `volunteered` is the most important column here: a problem the buyer raised
/// themselves is far stronger evidence than one we named and they agreed with,
/// and collapsing the two is how a hypothesis survives being wrong.
model ValidationConversation {
  id             String   @id @default(cuid())
  wedgeId        String
  person         String
  company        String?
  heldAt         DateTime @default(now())
  /// The problem, in their words.
  problem        String
  /// Which recurring problem this belongs to, assigned by an operator.
  ///
  /// Convergence is a judgement about whether two people described the same
  /// expensive problem in different words, and no string comparison can make
  /// that judgement. A conversation with no theme is excluded from convergence
  /// rather than guessed at.
  problemTheme   String?
  volunteered    Boolean  @default(false)
  quote          String?
  currentProcess String?
  triedBefore    String?
  consequence    String?
  notes          String?
  createdAt      DateTime @default(now())

  wedge MarketWedge @relation(fields: [wedgeId], references: [id], onDelete: Cascade)

  @@index([wedgeId, heldAt])
}

/// A prospect moving through Threadline's own acquisition and sales process.
model Prospect {
  id                   String    @id @default(cuid())
  company              String
  contactName          String?
  contactRole          String?
  website              String?
  state                String    @default("new") // see PROSPECT_STATES
  tier                 String    @default("b") // a | b | c
  wedgeId              String?
  /// How this prospect is being reached. Free text on purpose.
  channel              String?
  sourceNote           String?
  /// What one more good customer is worth to them, and how we know.
  economicsNote        String?
  /// Labelled a hypothesis, never a diagnosis.
  constraintHypothesis String?
  /// Set once a reply arrives and has been classified.
  replyClass           String?
  ownerId              String?
  nextAction           String?
  nextActionDueAt      DateTime?
  // The external CRM link. Three columns, no synchronisation.
  crmProvider          String?
  crmRecordId          String?
  crmRecordUrl         String?
  // Funnel timestamps. Every acquisition rate in the product is counted from
  // these rather than typed in, so the numbers cannot drift from what happened.
  firstTouchAt         DateTime?
  repliedAt            DateTime?
  positiveReplyAt      DateTime?
  closedAt             DateTime?
  closedReason         String?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  owner  User?        @relation("ProspectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  wedge  MarketWedge? @relation(fields: [wedgeId], references: [id], onDelete: SetNull)
  checks SopCheck[]
  calls  SalesCall[]

  // Discovery economics — every field nullable because "unknown" is a real answer.
  econCurrency           String        @default("GBP")
  typicalDealValueMinor  Int?
  grossProfitMinor       Int?
  grossMarginPct         Float?
  ltvMinor               Int?
  qualifiedOppValueMinor Int?
  cycleLengthDays        Int?
  closeRatePct           Float?
  capacityNote           String?
  acquisitionCostMinor   Int?
  acquisitionNote        String?
  urgency                String? // now | quarter | year | none
  economicConsequence    String?
  economicsUpdatedAt     DateTime?
  applications           Application[]
  /// Set when this prospect became a client workspace (COM-03).
  orgId                  String?
  convertedAt            DateTime?

  @@index([state, nextActionDueAt])
  @@index([tier, state])
  @@index([firstTouchAt])
}

/// One checklist item on one state of one record.
///
/// Shared by prospects and wedges because it is the same idea in both places:
/// the tick records that somebody looked, and the note records what they found.
/// For items the SOP marks as requiring evidence, the note is the part with
/// value and the tick alone does not satisfy the gate.
model SopCheck {
  id          String    @id @default(cuid())
  prospectId  String?
  wedgeId     String?
  /// The state this item belongs to. Keys repeat across states.
  state       String
  key         String
  done        Boolean   @default(false)
  note        String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  prospect Prospect?    @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  wedge    MarketWedge? @relation(fields: [wedgeId], references: [id], onDelete: Cascade)

  @@unique([prospectId, state, key])
  @@unique([wedgeId, state, key])
  @@index([prospectId])
  @@index([wedgeId])
}

/// A diagnosis call: preparation, the state map, and exactly one outcome.
model SalesCall {
  id            String    @id @default(cuid())
  prospectId    String
  scheduledAt   DateTime
  attended      Boolean   @default(false)
  /// Whether the prospect was genuinely a fit. This is what turns the
  /// qualification rate from an operator assumption into a measurement.
  qualified     Boolean   @default(false)
  offerMade     Boolean   @default(false)
  /// JSON string[] of CallStage — which information the call actually covered.
  stagesCovered String    @default("[]")
  /// JSON Record<CallStage, string> — what was learned at each stage.
  stageNotes    String    @default("{}")
  outcome       String? // won | follow_up | proposal_process | not_fit | lost
  /// Their exact words. Not a paraphrase into our language.
  voc           String?
  objections    String?
  valueMinor    Int       @default(0)
  currency      String    @default("GBP")
  ownerId       String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  owner    User?    @relation("CallOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  scriptSnapshots SalesCallScriptSnapshot[]

  @@index([scheduledAt])
  @@index([prospectId])
}

/// The reverse-engineered acquisition target for a period.
///
/// The assumed rates exist only to make the arithmetic possible before
/// Threadline has its own data, and are always rendered as assumptions. As soon
/// as real rates can be derived from prospect and call records, those are used
/// instead and the assumptions stay visible beside them so one win or one
/// no-show cannot silently rewrite the plan.
model AcquisitionTarget {
  id                      String   @id @default(cuid())
  label                   String
  targetWins              Int      @default(2)
  periodStart             DateTime
  periodEnd               DateTime
  status                  String   @default("active") // active | closed
  assumedBookingRatePct   Float    @default(0)
  assumedShowRatePct      Float    @default(0)
  assumedQualifiedRatePct Float    @default(0)
  assumedCloseRatePct     Float    @default(0)
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([status, periodStart])
}

/// The weekly acquisition control loop.
///
/// Counts are frozen before anything is changed, so the comparison stays
/// legible. One meaningful variable per week: changing five things at once
/// produces a result nobody can attribute to anything.
model FunnelReview {
  id              String   @id @default(cuid())
  weekStart       DateTime @unique
  /// JSON FunnelCounts, frozen at review time.
  counts          String   @default("{}")
  brokenStep      String?
  variableChanged String?
  hypothesis      String?
  learning        String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User? @relation("ReviewAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([weekStart])
}

// ---------------------------------------------------------------------------
// Attribution — content to commercial outcome
// ---------------------------------------------------------------------------
//
// The question this exists to answer is "which content is creating commercially
// valuable attention", and the chain it reconstructs is:
//
//   content asset -> tracked touchpoint -> visitor -> commercial event -> value
//
// THREE RULES SHAPE EVERY MODEL BELOW.
//
//   1. **A touchpoint is an observation, never an inference.** Each row is
//      something that actually happened and was recorded. Attribution models
//      read these rows; they never create them.
//   2. **Evidence strength is separate from the attribution model.** Splitting a
//      deal three ways does not make the connection to any of those three
//      assets better evidenced. `attribution` on a commercial event is the
//      evidence class and is never raised by arithmetic.
//   3. **Unknown stays unknown.** Every foreign key here is optional because
//      most real journeys are partial, and a model that needs a complete
//      journey to say anything would say nothing about real data.
//
// Identity is a first-party opaque token, nothing more. No fingerprinting, no
// device graph, no cross-device stitching, and no claim of identity certainty
// the mechanism cannot support.

/// A Threadline-owned redirect that records the click and sends the visitor on.
///
/// This is what makes attribution work without Threadline publishing the
/// content: the client or operator posts manually, uses the tracked URL in the
/// caption or bio, and the click is still ours to observe.
model TrackedLink {
  id              String   @id @default(cuid())
  orgId           String
  /// The public token in /t/<slug>. Short, unguessable, and never reused.
  slug            String   @unique
  label           String
  /// Where the visitor actually goes. Validated on write; see
  /// src/lib/domain/tracked-link.ts — an unvalidated destination here would be
  /// an open redirect wearing the company's domain.
  destinationUrl  String
  contentItemId   String?
  publishRecordId String?
  /// Where the link was placed. Free text; no channel is doctrine.
  platform        String?
  campaign        String?
  active          Boolean  @default(true)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contentItem   ContentItem?   @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  publishRecord PublishRecord? @relation(fields: [publishRecordId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("LinkAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  touchpoints   Touchpoint[]

  @@index([orgId, active])
  @@index([contentItemId])
}

/// An anonymous person, as far as a first-party cookie can describe one.
///
/// The token is random and opaque. It says "these touches were the same browser"
/// and nothing else — not who, not what device, not the same person on another
/// device. Treating it as more than that is how attribution starts lying.
model Visitor {
  id          String   @id @default(cuid())
  orgId       String
  /// Opaque, random, and unique per organisation rather than globally: one
  /// browser that reads two clients' content gets one cookie value and two
  /// visitor rows, so neither client can be linked to the other through it.
  token       String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  touchpoints Touchpoint[]
  inquiries   Inquiry[]
  events      CommercialEvent[]

  @@unique([orgId, token])
  @@index([orgId, lastSeenAt])
}

/// One recorded contact between a person and a piece of Threadline content.
model Touchpoint {
  id              String   @id @default(cuid())
  orgId           String
  visitorId       String?
  trackedLinkId   String?
  contentItemId   String?
  publishRecordId String?
  kind            String   @default("click") // click | form | reported | provider
  platform        String?
  campaign        String?
  /// Host only. A full referring URL can carry personal data in its query
  /// string, and the host answers the only question worth asking of it.
  referrerHost    String?
  /// Who observed this. Never invented.
  source          String   @default("native") // native | crm | booking | payment | manual | client_reported
  providerRef     String?
  note            String?
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  visitor       Visitor?       @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  trackedLink   TrackedLink?   @relation(fields: [trackedLinkId], references: [id], onDelete: SetNull)
  contentItem   ContentItem?   @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  publishRecord PublishRecord? @relation(fields: [publishRecordId], references: [id], onDelete: SetNull)

  @@index([orgId, occurredAt])
  @@index([visitorId, occurredAt])
  @@index([contentItemId])
}

/// A dated commercial event, with its provenance and its evidence class.
///
/// Separate from `Inquiry`, which is the person and their current stage. This
/// is the event log behind them: an enquiry, a booking, a call attended, an
/// opportunity, a win — each dated, each with a source, each answerable for how
/// well it connects to content.
model CommercialEvent {
  id                String   @id @default(cuid())
  orgId             String
  kind              String // opt_in | inquiry | booked_call | showed | qualified | opportunity | won
  occurredAt        DateTime @default(now())
  visitorId         String?
  inquiryId         String?
  valueMinor        Int      @default(0)
  currency          String   @default("GBP")
  source            String   @default("manual") // native | crm | booking | payment | manual | client_reported
  externalProvider  String?
  externalRecordId  String?
  externalRecordUrl String?
  /// Whether Threadline observed the figure or was told it.
  evidenceBasis     String   @default("client_reported") // measured | client_reported | unavailable
  /// How strongly this connects to content. NEVER raised by an attribution
  /// model — arithmetic redistributes credit, it does not create evidence.
  attribution       String   @default("qualitative_only")
  note              String?
  recordedById      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  visitor    Visitor?     @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  inquiry    Inquiry?     @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  recordedBy User?        @relation("EventRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  // Rev-share-ready fields (v1.5). Nothing here is used for billing at launch.
  cashCollectedMinor       Int?
  attributableRevenueMinor Int?
  attributionEligibility   String    @default("ineligible") // ineligible | eligible | agreed
  attributionStatus        String    @default("pending") // pending | confirmed | disputed | excluded
  attributablePercentage   Float?
  exclusionReason          String?
  collectedAt              DateTime?
  externalDealId           String?
  externalPaymentId        String?
  statusChangedAt          DateTime?
  statusChangedById        String?
  statusHistory            String    @default("[]") // JSON [{ at, by, from, to, reason }]

  @@index([orgId, occurredAt])
  @@index([orgId, kind])
  @@index([inquiryId])
}

// ---------------------------------------------------------------------------
// Research corpus and the Judge
// ---------------------------------------------------------------------------
//
// The corpus is real, high-performing content from the wedge's market. Like
// Threadline's own acquisition records it has **no orgId**: market evidence is
// not tenant data, and one corpus serves every client in the same wedge, which
// is the whole economic argument for building it (see ADR-011 for the same
// reasoning applied to prospects).
//
// It does two jobs. It is the signal source for what earns attention in this
// market — and, because every example has a known real-world outcome, it is the
// only material available for finding out whether the Judge's opinion is worth
// anything before that opinion is allowed near a client's content.

/// One piece of real market content, captured by hand.
model ResearchExample {
  id            String    @id @default(cuid())
  wedgeId       String?
  platform      String
  creatorHandle String
  creatorName   String?
  /// Canonical URL. Unique so the same piece cannot be counted twice.
  url           String    @unique
  title         String
  publishedAt   DateTime?
  capturedAt    DateTime  @default(now())

  // Metrics at capture. Absent is zero, and zero views means the example cannot
  // be banded rather than that nobody watched it.
  views     Int @default(0)
  likes     Int @default(0)
  comments  Int @default(0)
  shares    Int @default(0)
  saves     Int @default(0)
  /// Creator's follower count at capture. Zero when unknown.
  followers Int @default(0)

  /// short_video | long_video | carousel | text_post | newsletter | podcast |
  /// unknown. Format is part of what makes two pieces comparable, so it is the
  /// first thing the baseline ladder narrows on.
  format String @default("unknown")

  /// direct | adjacent | off_icp | unrated — operator judgement, never inferred.
  ///
  /// An LLM asked whether content is relevant to our buyer will find a way to
  /// say yes. `unrated` is an honest state, and the corpus reading says how many
  /// rows are in it rather than assuming.
  buyerRelevance String @default("unrated")

  /// commercial | mixed | entertainment | unrated — whether the *attention*
  /// looks like it could belong to a buyer. Read together with buyerRelevance
  /// this is what separates a commercial outlier from a popular irrelevance.
  commercialIntent String @default("unrated")

  /// Where the descriptive fields came from: manual | auto_oembed | auto_page |
  /// url_only. Recorded because a title a machine read and a title a person
  /// typed are not equally trustworthy, and the difference stops mattering
  /// silently once there are 300 rows.
  provenance String @default("manual")

  /// Where the *numbers* came from: manual | api | unknown.
  ///
  /// Held separately from `provenance` and it matters more, because the metrics
  /// are what the banding is computed from. No unauthenticated public endpoint
  /// returns a view count on any platform in this wedge, so until the platform
  /// applications land this is `manual` for every real row — and the corpus says
  /// so rather than implying the figures were measured.
  metricsProvenance String @default("manual")

  /// When enrichment last ran, and what it could and could not get.
  enrichedAt     DateTime?
  enrichmentNote String?

  transcript String?
  notes      String?

  /// A placeholder shipped with the seed to make the machinery visible.
  ///
  /// Never a real creator and never real metrics, so it is excluded from
  /// calibration by default — a rubric checked against invented outcomes would
  /// be worse than an unchecked one.
  illustrative Boolean @default(false)

  addedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wedge    MarketWedge?     @relation(fields: [wedgeId], references: [id], onDelete: SetNull)
  addedBy  User?            @relation("ExampleAuthor", fields: [addedById], references: [id], onDelete: SetNull)
  analysis ExampleAnalysis?
  verdicts JudgeVerdict[]

  @@index([wedgeId])
  @@index([creatorHandle])
  @@index([platform])
}

/// What an LLM extracted from one example. Structured so it can be clustered.
model ExampleAnalysis {
  id        String @id @default(cuid())
  exampleId String @unique

  topic               String?
  buyerPain           String?
  hook                String?
  thesis              String?
  promise             String?
  proof               String?
  format              String?
  storyStructure      String?
  cta                 String?
  emotionalDriver     String?
  whyItWorked         String?
  /// commercial | mixed | entertainment — whether the attention looks like it
  /// could belong to a buyer, which is the only kind Threadline is optimising
  /// for.
  commercialRelevance String  @default("mixed")

  provider      String
  model         String
  promptVersion String
  createdAt     DateTime @default(now())

  example ResearchExample @relation(fields: [exampleId], references: [id], onDelete: Cascade)
}

/// One adversarial evaluation pass.
///
/// Subject is polymorphic by design: the same rubric scores a candidate idea for
/// a client and a corpus example with a known outcome, which is what makes the
/// second usable to check the first.
model JudgeVerdict {
  id          String  @id @default(cuid())
  subjectType String // idea | script | example
  subjectId   String
  /// Null for corpus examples, which belong to no tenant.
  orgId       String?
  exampleId   String?

  rubricVersion String
  overall       Int
  verdict       String // pass | revise | reject
  /// JSON CriterionScore[]
  scores        String @default("[]")
  /// JSON string[]
  concerns      String @default("[]")

  /// Always false while the rubric is unchecked against client outcomes. Stored
  /// rather than computed so an old verdict cannot be retrospectively promoted
  /// by a later calibration.
  calibrated Boolean @default(false)

  provider  String
  model     String
  createdAt DateTime @default(now())

  org     Organization?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  example ResearchExample? @relation(fields: [exampleId], references: [id], onDelete: Cascade)

  @@index([subjectType, subjectId])
  @@index([orgId, createdAt])
}

/// A frozen record of how well the Judge tracked reality on a given day.
model JudgeCalibration {
  id            String   @id @default(cuid())
  runAt         DateTime @default(now())
  rubricVersion String
  pairs         Int      @default(0)
  outperformers Int      @default(0)
  /// Mean score gap between examples that outperformed and those that did not.
  separation    Float?
  sufficient    Boolean  @default(false)
  reading       String
  /// JSON payload, frozen: a later corpus change must not rewrite what a past
  /// run concluded.
  payload       String   @default("{}")
  runById       String?
  createdAt     DateTime @default(now())

  @@index([runAt])
}

/// ---------------------------------------------------------------------------
/// CONTENT LINEAGE AND THE LEARNING LOOP
///
/// SCORE -> EXPLAIN -> DIAGNOSE -> PRESCRIBE -> RETEST
///
/// The question these models answer is not "how did this post do". It is "what
/// did we believe would happen, what actually happened, why did those differ,
/// and did the change we made in response work". Without a persistent identity
/// for the *thesis*, that question cannot even be asked: every re-hook and
/// cross-post looks like an unrelated new idea, and the system relearns the
/// same lesson forever.
/// ---------------------------------------------------------------------------

/// The persistent identity of one commercial thesis. The ROOT_ID.
///
/// A root is the claim being tested — "founders lose the expertise when the
/// senior person leaves the room" — not a piece of content. Everything made in
/// service of that claim hangs off it: the original short video, the re-hooked
/// retest, the LinkedIn text version, the carousel cut from the same interview.
///
/// A genuinely new claim gets a new root. A new hook on the same claim does
/// not, which is the whole point: it stays comparable.
model ContentRoot {
  id     String @id @default(cuid())
  orgId  String
  /// Short internal name. Client surfaces call these "test families".
  label  String
  /// The claim being tested, in one sentence.
  thesis String

  /// Who the claim is aimed at, when narrower than the org's ICP.
  audience String?
  pillar   String?

  /// open | winning | exhausted | abandoned
  ///
  /// `exhausted` means the thesis was proven and has stopped teaching us
  /// anything new; `abandoned` means the evidence said the claim was wrong.
  /// Both are useful and neither is a failure of the system.
  status String @default("open")

  /// Set when the root is closed, with the reason in `closedReason`.
  closedAt     DateTime?
  closedReason String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org          Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User?                @relation("RootAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  ideas        Idea[]
  contentItems ContentItem[]
  expectations ContentExpectation[]
  diagnoses    ContentDiagnosis[]
  corrections  CorrectionEntry[]

  @@index([orgId, status])
  @@index([orgId, createdAt])
}

/// A frozen pre-publication expectation.
///
/// Written before the piece goes out and never rewritten. When the rubric
/// changes, old expectations keep their old `rubricVersion` and their old
/// numbers — a prediction edited after the result is known is not a prediction,
/// and a calibration run over retrofitted scores would measure nothing.
///
/// `calibrated` is stored rather than derived for the same reason (ADR-018): a
/// later calibration cannot retrospectively promote an opinion formed before
/// there was evidence for it.
model ContentExpectation {
  id     String  @id @default(cuid())
  orgId  String
  rootId String?

  /// idea | script | content
  subjectType String
  subjectId   String

  rubricVersion String
  /// 0-100, computed by us from the criterion scores. Never asked of the model.
  overall       Int
  /// JSON: { key, label, score, weight, reason }[] — the decomposition, which
  /// is the part that is actually useful.
  dimensions    String @default("[]")

  /// JSON string[] — what we expect to carry the piece, and what we expect to
  /// hold it back. Stated up front so a post-hoc explanation cannot quietly
  /// become the thing we "always thought".
  predictedStrengths  String @default("[]")
  predictedWeaknesses String @default("[]")

  /// under | typical | strong | exceptional | unknown — a defensible guess at
  /// the performance class, or `unknown` when there is no basis for one.
  expectedClass String @default("unknown")
  /// low | moderate | high
  confidence    String @default("low")

  /// Always false at write time. See ADR-018.
  calibrated Boolean @default(false)

  provider      String  @default("none")
  model         String  @default("none")
  promptVersion String  @default("none")
  /// Free-text reasoning kept for error analysis, never shown as a verdict.
  reasoning     String?

  createdById String?
  createdAt   DateTime @default(now())

  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  root      ContentRoot?       @relation(fields: [rootId], references: [id], onDelete: SetNull)
  createdBy User?              @relation("ExpectationAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  diagnoses ContentDiagnosis[]

  @@index([orgId, subjectType, subjectId])
  @@index([rootId])
  @@index([orgId, rubricVersion])
}

/// What we concluded once reality arrived.
///
/// The *evidence* is frozen into `evidence` at diagnosis time rather than
/// recomputed, because the snapshots keep arriving and a diagnosis has to stay
/// readable as the judgement made on the evidence available that day. The
/// live reading is computed elsewhere and is deliberately a different thing.
model ContentDiagnosis {
  id            String  @id @default(cuid())
  orgId         String
  rootId        String?
  contentItemId String?
  expectationId String?

  /// The observation window the conclusion rests on.
  windowStart  DateTime?
  windowEnd    DateTime?
  /// Days between publication and the last snapshot used.
  maturityDays Int?

  /// JSON: the frozen actual reading — metrics, derived rates, comparisons and
  /// explicit unknowns.
  evidence String @default("{}")

  strongestDimension String?
  weakestDimension   String?

  /// idea_thesis | icp_targeting | hook_packaging | delivery |
  /// retention_structure | proof_credibility | distribution | cta_conversion |
  /// commercial_relevance | mixed | insufficient_data | none
  ///
  /// `mixed` and `insufficient_data` are first-class answers. Forcing a single
  /// cause onto ambiguous evidence is how a learning system teaches itself
  /// something false.
  failureClass String @default("insufficient_data")

  explanation      String?
  /// The specific belief that turned out to be wrong.
  failedAssumption String?

  /// low | moderate | high
  confidence String @default("low")

  /// Whether the underlying claim survives. A packaging failure on a good
  /// thesis is the most common and most valuable result there is.
  preserveThesis Boolean @default(true)

  /// What to do next, and how much of it.
  prescription     String?
  nextIntervention String?
  retestBatchSize  Int?
  targetPlatform   String?
  targetFormat     String?

  /// Model assistance is recorded, never hidden. A diagnosis drafted by an LLM
  /// and approved by a person is a different object from one a person wrote.
  aiAssisted    Boolean @default(false)
  provider      String  @default("none")
  model         String  @default("none")
  promptVersion String  @default("none")

  /// draft | approved | superseded — a diagnosis only becomes authoritative
  /// when a human approves it.
  approvalState String    @default("draft")
  approvedAt    DateTime?
  approvedById  String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  root        ContentRoot?        @relation(fields: [rootId], references: [id], onDelete: SetNull)
  contentItem ContentItem?        @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  expectation ContentExpectation? @relation(fields: [expectationId], references: [id], onDelete: SetNull)
  approvedBy  User?               @relation("DiagnosisApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy   User?               @relation("DiagnosisAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  corrections CorrectionEntry[]

  @@index([orgId, createdAt])
  @@index([rootId])
  @@index([contentItemId])
}

/// Correction memory.
///
/// MODEL BELIEVED -> ACTUAL RESULT -> FAILED ASSUMPTION -> CORRECTION.
///
/// This is the part that compounds. A miss that is merely observed teaches
/// nothing; a miss with a recorded correction and a later verdict on whether
/// the correction worked is the only mechanism by which the system gets better
/// at this particular founder in this particular market.
model CorrectionEntry {
  id          String  @id @default(cuid())
  orgId       String
  rootId      String?
  diagnosisId String?

  believed         String
  actual           String
  failedAssumption String
  correction       String

  /// What was changed in response, as a machine-readable hint for later
  /// pattern-finding: hook | thesis | icp | proof | structure | delivery |
  /// distribution | cta | format | platform | other
  lever String @default("other")

  /// Did it work? Null until a retest has been read. Null is the honest state
  /// for most entries most of the time and must never be rendered as "no".
  worked      Boolean?
  /// How we know, once we know.
  verdictNote String?
  verdictAt   DateTime?

  /// The content made to test the correction.
  retestContentItemId String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org       Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  root      ContentRoot?      @relation(fields: [rootId], references: [id], onDelete: SetNull)
  diagnosis ContentDiagnosis? @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  createdBy User?             @relation("CorrectionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([rootId])
  @@index([orgId, lever])
}

/// ---------------------------------------------------------------------------
/// CREDENTIALS AND HONEST CONNECTION STATE
/// ---------------------------------------------------------------------------

/// An encrypted secret belonging to one tenant.
///
/// Held apart from `Integration.config` on purpose: that column is documented
/// as non-secret configuration and is read in places where a token has no
/// business being. Secrets live here, sealed with AES-256-GCM and bound to the
/// tenant that owns them (`src/lib/security/secret-box.ts`), so a row copied
/// into another organisation fails to decrypt rather than working.
model Credential {
  id       String @id @default(cuid())
  orgId    String
  provider String
  /// oauth_access | oauth_refresh | api_key | webhook_secret
  purpose  String

  /// The sealed payload as JSON: { v, keyId, nonce, ciphertext, tag }.
  /// Never plaintext, never logged, never returned to a client component.
  sealed String
  /// Denormalised from `sealed` so a rotation sweep can find stale rows without
  /// decrypting every secret it looks at.
  keyId  String

  /// When the provider says this expires. Null when it does not.
  expiresAt DateTime?
  /// JSON string[] — what the provider actually granted, which is frequently
  /// not what was asked for.
  scopes    String    @default("[]")

  externalAccountId    String?
  externalAccountLabel String?

  rotatedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider, purpose])
  @@index([orgId, provider])
  @@index([keyId])
}

/// One attempt to connect an account, held across the redirect to the provider.
///
/// `state` is the CSRF defence for the OAuth handshake and is stored rather
/// than signed into a cookie so that a callback can be verified exactly once:
/// the row is consumed on use, which makes replay impossible rather than
/// merely unlikely.
model OAuthState {
  id              String  @id @default(cuid())
  orgId           String
  provider        String
  /// Random, single-use, compared in constant time.
  state           String  @unique
  /// PKCE verifier where the provider supports it. Sealed, because it is a
  /// secret for the lifetime of the handshake.
  sealedVerifier  String?
  /// Where to send the operator once the callback completes. Validated against
  /// the app's own origin before use — an open redirect here would be handed a
  /// provider's trust.
  returnTo        String?
  /// JSON string[] — what we asked for, so the callback can report what was
  /// refused rather than assuming it got everything.
  scopesRequested String  @default("[]")

  createdById String?
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("OAuthInitiator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId, provider])
  @@index([expiresAt])
}

/**
 * -------------------------------------------------------------------------
 */
/**
 * Completion pass 2026-09-09: email, jobs, sales scripts, proof permissions
 */
/**
 * -------------------------------------------------------------------------
 */

model AuthToken {
  id          String    @id @default(cuid())
  userId      String
  kind        String // invite | password_reset
  tokenHash   String    @unique
  orgId       String?
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([expiresAt])
}

model EmailMessage {
  id         String    @id @default(cuid())
  orgId      String?
  toEmail    String
  template   String
  subject    String
  textBody   String
  htmlBody   String
  provider   String // capture | resend | smtp
  status     String    @default("queued") // queued | sent | failed | captured | suppressed
  providerId String?
  error      String?
  jobId      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  /// Delivery events from the provider's webhook (NOT-02).
  deliveredAt   DateTime?
  bouncedAt     DateTime?
  complainedAt  DateTime?
  deliveryError String?

  @@index([toEmail, createdAt])
  @@index([providerId])
  @@index([status])
}

model Job {
  id             String    @id @default(cuid())
  type           String
  payload        String    @default("{}") // JSON
  status         String    @default("queued") // queued | running | succeeded | failed | dead
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  runAt          DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  completedAt    DateTime?
  idempotencyKey String?   @unique
  orgId          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAt])
  @@index([type, status])
}

model SalesScript {
  id         String                    @id @default(cuid())
  key        String // stable identity across versions, e.g. "discovery.open"
  version    Int
  stage      String // outreach | research_call | discovery | diagnosis | offer | objection | close | kickoff
  context    String // when this block is used, in a sentence
  exactText  String
  checksum   String // sha256 of exactText
  status     String                    @default("draft") // draft | approved | retired
  provenance String // where the wording came from — document, author, date
  createdAt  DateTime                  @default(now())
  approvedAt DateTime?
  retiredAt  DateTime?
  snapshots  SalesCallScriptSnapshot[]

  @@unique([key, version])
  @@index([stage, status])
}

model SalesCallScriptSnapshot {
  id        String      @id @default(cuid())
  callId    String
  scriptId  String
  key       String
  version   Int
  checksum  String
  exactText String
  usedAt    DateTime    @default(now())
  call      SalesCall   @relation(fields: [callId], references: [id], onDelete: Cascade)
  script    SalesScript @relation(fields: [scriptId], references: [id], onDelete: Restrict)

  @@index([callId])
}

model ProofPermission {
  id                     String       @id @default(cuid())
  orgId                  String       @unique
  interviewWillingness   String       @default("unknown") // unknown | yes | maybe | no
  successConfirmedAt     DateTime?
  successConfirmedById   String?
  successNote            String?
  allowInterview         Boolean      @default(false)
  allowInternalUse       Boolean      @default(false)
  allowTestimonial       Boolean      @default(false)
  allowPublicTestimonial Boolean      @default(false)
  allowNamedCaseStudy    Boolean      @default(false)
  allowAnonCaseStudy     Boolean      @default(false)
  allowPublishMetrics    Boolean      @default(false)
  allowLogo              Boolean      @default(false)
  grantedAt              DateTime?
  grantedNote            String?
  requestedAt            DateTime?
  /// PRF-01: when the permissions lapse (null = until withdrawn), and what they cover.
  expiresAt              DateTime?
  scopeNote              String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  org                    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  orgId       String?
  eventType   String
  payload     String // JSON, secrets stripped
  verified    Boolean   @default(false)
  processedAt DateTime?
  error       String?
  receivedAt  DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([provider, receivedAt])
}

/// A pending invitation to a workspace (TEAM-02). No user or membership exists
/// until the invitee accepts; the link carries a random token stored only as a
/// hash, single use, with an expiry.
model Invitation {
  id             String    @id @default(cuid())
  orgId          String
  email          String
  name           String
  title          String?
  role           String
  profiles       String    @default("[]")
  isExpert       Boolean   @default(false)
  tokenHash      String    @unique
  invitedById    String?
  expiresAt      DateTime
  /// pending | accepted | revoked | expired
  state          String    @default("pending")
  sentCount      Int       @default(0)
  lastSentAt     DateTime?
  acceptedAt     DateTime?
  acceptedUserId String?
  revokedAt      DateTime?
  revokedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User?        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([orgId, state])
  @@index([email])
}

/// Assignment-scoped access for contractors, editors and QA reviewers (TEAM-09):
/// with an assignment scope they see only the work they are assigned to.
model WorkAssignment {
  id            String   @id @default(cuid())
  orgId         String
  userId        String
  /// editor | backup_editor | qa_reviewer
  kind          String
  /// null = every item in the workspace of this kind of work
  contentItemId String?
  createdById   String?
  createdAt     DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, kind, contentItemId])
  @@index([userId])
}

/// A commercial offer Threadline sells (ENG-02). Engagements copy its terms at
/// signing, so changing an offer never rewrites a signed engagement.
model OfferTemplate {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String?
  currency       String   @default("GBP")
  setupFeeMinor  Int
  periodFeeMinor Int
  periodDays     Int      @default(28)
  initialPeriods Int      @default(3)
  /// JSON: what each period includes (entitlements).
  entitlements   String   @default("{}")
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  engagements Engagement[]
}

/// One client engagement (ENG-01): the signed terms, the calendar and the state.
model Engagement {
  id                  String    @id @default(cuid())
  orgId               String
  offerTemplateId     String?
  /// The offer's terms exactly as signed (JSON), immune to later offer edits.
  offerSnapshot       String    @default("{}")
  agreementVersion    String?
  agreementSignedAt   DateTime?
  /// Where the signed agreement lives (a document id or storage path), never its content.
  agreementEvidence   String?
  currency            String    @default("GBP")
  setupFeeMinor       Int
  periodFeeMinor      Int
  periodDays          Int       @default(28)
  initialPeriods      Int       @default(3)
  /// Calendar date the first period starts, in the workspace's timezone.
  startDate           DateTime? @db.Date
  timezone            String    @default("Europe/London")
  /// draft | active | paused | ended | terminated
  status              String    @default("draft")
  activatedAt         DateTime?
  pausedAt            DateTime?
  endedAt             DateTime?
  endReason           String?
  entitlements        String    @default("{}")
  earlyWinDueDate     DateTime? @db.Date
  /// ENG-03: the concrete early win agreed at kickoff, and when it actually happened (with evidence).
  earlyWinDefinition  String?
  earlyWinAchievedOn  DateTime? @db.Date
  earlyWinEvidence    String?
  /// ENG-03: the client's sign-off that installation is done; refused until every checklist item is complete.
  installationSignedOffAt   DateTime?
  installationSignedOffById String?
  /// BIL-02: exactly one invoice authority per engagement: manual | stripe.
  billingProvider     String    @default("manual")
  stripeCustomerId    String?
  /// Days allowed to pay an issued invoice.
  paymentTermsDays    Int       @default(14)
  sourceApplicationId String?   @unique
  sourceProspectId    String?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  offer        OfferTemplate? @relation(fields: [offerTemplateId], references: [id], onDelete: SetNull)
  periods      ServicePeriod[]
  scopeChanges ScopeChange[]

  @@index([orgId, status])
}

/// A 28-day service period (ENG-01, ENG-06). Dates are calendar dates in the
/// engagement's timezone; the end date is exclusive.
model ServicePeriod {
  id           String   @id @default(cuid())
  engagementId String
  orgId        String
  number       Int
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  feeMinor     Int
  /// upcoming | current | complete | paused
  status       String   @default("upcoming")
  createdAt    DateTime @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@unique([engagementId, number])
  @@index([orgId, startDate])
}

/// A change to what the engagement includes (ENG-05), approved before it applies.
model ScopeChange {
  id                  String    @id @default(cuid())
  engagementId        String
  orgId               String
  summary             String
  detail              String?
  /// proposed | approved | rejected
  state               String    @default("proposed")
  requestedById       String?
  decidedById         String?
  decidedAt           DateTime?
  effectiveFromPeriod Int?
  feeChangeMinor      Int?
  createdAt           DateTime  @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId, state])
}

/// Outbound CRM work (COM-04): each change Threadline must mirror into the CRM
/// is a durable row, sent by a job, retried, and never lost if the CRM is down.
model CrmOutbox {
  id             String    @id @default(cuid())
  provider       String
  entityType     String
  entityId       String
  operation      String
  payload        String
  idempotencyKey String    @unique
  /// pending | sent | failed | dead | needs_review
  state          String    @default("pending")
  attempts       Int       @default(0)
  lastError      String?
  remoteId       String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  @@index([state, createdAt])
  @@index([entityType, entityId])
}

/// The mapping between a Threadline record and its CRM record (COM-04).
model CrmLink {
  id           String   @id @default(cuid())
  provider     String
  entityType   String
  entityId     String
  remoteObject String
  remoteId     String
  remoteUrl    String?
  lastSyncedAt DateTime @default(now())

  @@unique([provider, entityType, entityId])
  @@unique([provider, remoteObject, remoteId])
}

/// One approval decision on one exact version of a piece of work (DEL-02).
/// `contentHash` fingerprints what was approved; any material edit changes the
/// hash, which makes this approval stale (DEL-03). Nothing is ever approved
/// automatically: every row names the person and the authority they acted on.
model Approval {
  id                String    @id @default(cuid())
  orgId             String
  /// idea | script | content_item | platform_package
  entityType        String
  entityId          String
  /// Human-readable version label: script v3, cut 2, package edit time.
  versionLabel      String?
  contentHash       String
  /// approved | changes_requested | rejected
  decision          String
  reviewerId        String?
  /// designated_approver | backup_approver | workspace_admin | staff_on_behalf
  authority         String
  /// What the approval covers, e.g. "LinkedIn post" or "all platforms".
  scope             String?
  note              String?
  reviewRequestedAt DateTime?
  decidedAt         DateTime  @default(now())
  /// Set when a later material edit made this approval stale.
  supersededAt      DateTime?
  supersededReason  String?
  batchId           String?

  batch ReviewBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([orgId, entityType, entityId])
  @@index([orgId, decidedAt])
}

/// A set of items sent to the client for review together (CX-02). Each item is
/// pinned to the hash it had when the batch was sent; a bulk decision applies
/// only to items still at that hash.
model ReviewBatch {
  id          String    @id @default(cuid())
  orgId       String
  title       String
  createdById String?
  dueAt       DateTime?
  /// open | closed
  state       String    @default("open")
  createdAt   DateTime  @default(now())
  closedAt    DateTime?

  items     ReviewBatchItem[]
  approvals Approval[]

  @@index([orgId, state])
}

model ReviewBatchItem {
  id          String  @id @default(cuid())
  batchId     String
  entityType  String
  entityId    String
  contentHash String
  /// null until decided: approved | changes_requested | rejected | stale
  outcome     String?

  batch ReviewBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, entityType, entityId])
}

/// An invoice (BIL-01). Issued invoices are never edited: a mistake is voided
/// with a reason, or corrected with a credit note. Amounts in minor units.
model Invoice {
  id                String    @id @default(cuid())
  orgId             String
  engagementId      String?
  number            String    @unique
  /// setup | period | adjustment | credit_note
  kind              String
  periodNumber      Int?
  currency          String    @default("GBP")
  totalMinor        Int
  /// draft | issued | paid | void
  status            String    @default("draft")
  issuedAt          DateTime?
  dueDate           DateTime? @db.Date
  paidAt            DateTime?
  voidedAt          DateTime?
  voidReason        String?
  /// manual | stripe
  provider          String    @default("manual")
  providerInvoiceId String?   @unique
  hostedUrl         String?
  /// For a credit note: the invoice it credits.
  creditsInvoiceId  String?
  notes             String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  lines    InvoiceLine[]
  payments Payment[]
  disputes Dispute[]

  @@index([orgId, status])
  @@index([engagementId, kind, periodNumber])
}

model InvoiceLine {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int    @default(1)
  unitMinor   Int
  amountMinor Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

/// Money in or out against an invoice (BIL-01): a payment (positive), a refund
/// (negative). Partial payments are simply several rows. Provider ids are
/// unique so a redelivered webhook cannot record the same payment twice.
model Payment {
  id                String   @id @default(cuid())
  orgId             String
  invoiceId         String
  amountMinor       Int
  /// payment | refund
  kind              String   @default("payment")
  /// bank_transfer | card | stripe | other
  method            String
  receivedAt        DateTime
  reference         String?
  /// Where the evidence is (bank statement line, remittance email), never the evidence itself.
  evidence          String?
  providerPaymentId String?  @unique
  recordedById      String?
  createdAt         DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([orgId, receivedAt])
}

model Dispute {
  id                String    @id @default(cuid())
  orgId             String
  invoiceId         String
  reason            String
  /// open | won | lost | withdrawn
  state             String    @default("open")
  amountMinor       Int?
  providerDisputeId String?   @unique
  openedAt          DateTime  @default(now())
  closedAt          DateTime?
  note              String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
}

/// A signed agreement (BIL-03): which document, which version, when and by whom.
/// The file itself lives in storage; this row is the evidence trail.
model AgreementDocument {
  id           String   @id @default(cuid())
  orgId        String
  engagementId String?
  /// msa | dpa | sow | order_form
  kind         String
  version      String
  signedAt     DateTime
  signedByName String
  signedByRole String?
  /// Storage path or e-signature envelope id.
  evidence     String
  recordedById String?
  createdAt    DateTime @default(now())

  @@index([orgId, kind])
}

/// A reminder about an overdue invoice (BIL-04), drafted by the system and
/// sent only when a person approves it.
model PaymentReminder {
  id           String    @id @default(cuid())
  orgId        String
  invoiceId    String
  toEmail      String
  subject      String
  body         String
  /// draft | approved | sent | discarded
  state        String    @default("draft")
  approvedById String?
  approvedAt   DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([orgId, state])
}

/// The permanent record of an offboarding (OFF-01, PRV-01). Deliberately not
/// linked to the organisation, so it survives the tenant's deletion as the
/// evidence of what was done, when, and by whom.
model OffboardingRecord {
  id             String    @id @default(cuid())
  orgId          String    @unique
  orgName        String
  reason         String
  /// JSON: each step with its outcome and time.
  steps          String    @default("[]")
  startedById    String?
  startedAt      DateTime  @default(now())
  accessEndsAt   DateTime
  retentionUntil DateTime
  exportAssetId  String?
  deletedAt      DateTime?
  /// JSON: row counts removed, per table, at deletion.
  deletionCounts String?
}

/// How a person wants to hear about work (NOT-01), per workspace. Email is
/// off unless the person turns it on: in-app notifications always appear.
model NotificationPreference {
  id           String    @id @default(cuid())
  userId       String
  orgId        String
  /// off | immediate | digest
  email        String    @default("off")
  /// Local hours (0-23) during which nothing is emailed; digests wait.
  quietStart   Int?
  quietEnd     Int?
  timezone     String    @default("Europe/London")
  snoozedUntil DateTime?
  lastDigestAt DateTime?
  updatedAt    DateTime  @default(now()) @updatedAt

  @@unique([userId, orgId])
}

/// A renewal decision (RNW-01), opened ahead of the end of the initial term
/// or of any later period an owner marks, and decided by a person.
model RenewalReview {
  id           String    @id @default(cuid())
  orgId        String
  engagementId String
  /// The period whose end prompts the review.
  periodNumber Int
  dueDate      DateTime  @db.Date
  /// open | renewed | paused | expanded | ended | handed_over
  state        String    @default("open")
  note         String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([engagementId, periodNumber])
  @@index([orgId, state])
}

/// Where Threadline uses a client's proof (PRF-01): which permission it rests
/// on and where it appears. Withdrawing or expiring the permission flags every
/// placement that relies on it, for a person to take down.
model ProofPlacement {
  id           String    @id @default(cuid())
  orgId        String
  /// The ProofPermission flag this relies on, e.g. allowPublicTestimonial.
  permission   String
  /// What is used: the quote, figure or logo, as placed.
  content      String
  /// Where it appears (page URL, deck name, proposal).
  location     String
  evidence     String?
  placedById   String?
  placedAt     DateTime  @default(now())
  flaggedAt    DateTime?
  flagReason   String?
  removedAt    DateTime?

  @@index([orgId, permission])
}


/// A direct-to-storage upload in progress (FILE-02). The browser sends parts
/// straight to the bucket with short-lived signed URLs; the server verifies the
/// assembled object (size and content signature) before any Asset exists.
model UploadSession {
  id              String    @id @default(cuid())
  orgId           String
  userId          String
  storagePath     String    @unique
  storageProvider String
  /// The storage provider's multipart upload id.
  uploadId        String?
  fileName        String
  mimeType        String
  sizeBytes       Int
  partSize        Int
  partCount       Int
  status          String    @default("uploading") // uploading | complete | failed | aborted | expired
  category        String
  title           String?
  contentItemId   String?
  assetId         String?
  error           String?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([orgId, userId])
}

/// One processing step for a stored file (FILE-05): transcoding, transcription
/// or a thumbnail, done by an external worker that reports back through a
/// signed callback. States only move forward; a late or repeated callback
/// never undoes a finished task.
model ProcessingTask {
  id            String    @id @default(cuid())
  orgId         String
  assetId       String
  kind          String // transcode | transcribe | thumbnail
  provider      String // webhook | none
  status        String    @default("queued") // queued | submitted | processing | succeeded | failed | cancelled
  externalId    String?
  attempts      Int       @default(0)
  /// JSON: what the worker returned (duration, renditions, transcript asset id).
  result        String?
  outputAssetId String?
  error         String?
  submittedAt   DateTime?
  lastEventAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  asset Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, kind])
  @@index([status])
}

/// Minutes a person spent on a step of the work (CX-08, CAP-01). Founder
/// minutes are the product's promise ("under an hour a week"), operator minutes
/// are the capacity model's input. Entered by hand or from a timer; never
/// inferred.
model EffortEntry {
  id            String   @id @default(cuid())
  orgId         String
  userId        String
  /// founder | client_team | operator | editor
  actorKind     String
  /// The step: onboarding | recording | review | approval | call | scripting | editing | packaging | reporting | publishing | other
  step          String
  minutes       Int
  /// The day the work happened (calendar date, workspace timezone).
  workDate      DateTime @db.Date
  contentItemId String?
  note          String?
  source        String   @default("manual") // manual | timer
  createdAt     DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, workDate])
  @@index([orgId, actorKind, workDate])
}

/// One message in a lead's thread (AI-06). Inbound messages arrive through an
/// authorised source or are entered by a person; outbound ones are recorded
/// when a person marks an approved reply as sent. Never sent by the system.
model LeadMessage {
  id          String   @id @default(cuid())
  orgId       String
  inquiryId   String
  direction   String // in | out
  channel     String
  body        String
  /// The provider's message id; a repeat delivery is ignored.
  externalRef String?
  occurredAt  DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@unique([orgId, channel, externalRef])
  @@index([inquiryId, occurredAt])
}

/// A reply drafted for a person to check and send themselves (AI-06).
model ReplyDraft {
  id           String    @id @default(cuid())
  orgId        String
  inquiryId    String
  body         String
  status       String    @default("draft") // draft | approved | sent | discarded
  generatedBy  String    @default("human") // ai | human
  isDemo       Boolean   @default(false)
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  sentById     String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, status])
}

/// An authorised inbound lead source for a workspace (a website form, a
/// Zapier step, an import). The token is shown once and stored only as a hash.
model InboundSource {
  id         String    @id @default(cuid())
  orgId      String
  label      String
  channel    String    @default("website_form")
  tokenHash  String    @unique
  createdById String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// Addresses that must not be mailed (NOT-02): a permanent bounce or a spam
/// complaint adds one automatically; staff can add or lift one by hand.
model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String // bounce | complaint | manual
  detail    String?
  createdAt DateTime @default(now())
  liftedAt  DateTime?
}

/// Every version of a workspace's Brand Brain (AI-03, ENG-04), written by a
/// database trigger so no code path can change the context without a record.
model BrandBrainVersion {
  id           String   @id @default(cuid())
  orgId        String
  version      Int
  company      String
  founder      String
  voice        String
  contentRules String
  /// JSON string[] of the sections that changed from the previous version.
  changed      String   @default("[]")
  createdAt    DateTime @default(now())

  @@unique([orgId, version])
}

/// A lesson that generation must follow (LRN-02). It comes from a correction a
/// retest confirmed, or is written by staff with a stated basis. It applies to
/// the whole workspace or to one platform, is shown in the AI context as
/// "lessons in force", and is retired (never deleted) to roll it back.
model GenerationLesson {
  id           String    @id @default(cuid())
  orgId        String
  text         String
  /// workspace | platform
  scope        String    @default("workspace")
  platform     String?
  basis        String
  correctionId String?
  status       String    @default("active") // active | retired
  activatedById String?
  activatedAt  DateTime  @default(now())
  retiredById  String?
  retiredAt    DateTime?
  retiredReason String?

  @@index([orgId, status])
}

/// An on-demand export of a workspace's records (FILE-06, PRV). Built by a
/// job into private storage; downloadable by admins for seven days, then the
/// file is deleted and the row kept as the record that it happened.
model DataExport {
  id            String    @id @default(cuid())
  orgId         String
  requestedById String
  status        String    @default("queued") // queued | ready | failed | expired
  assetId       String?
  sizeBytes     Int?
  error         String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  readyAt       DateTime?

  @@index([orgId, createdAt])
  @@index([status, expiresAt])
}

/// An internal QA pass on a cut before the client sees it (DEL-06), against
/// the editor QA checklist, bound to the version checked.
model QaReview {
  id            String   @id @default(cuid())
  orgId         String
  contentItemId String
  versionLabel  String
  reviewerId    String
  /// JSON [{ key, pass, note }]
  checks        String
  result        String // pass | fail
  notes         String?
  createdAt     DateTime @default(now())

  @@index([orgId, contentItemId, createdAt])
}
