model AiGeneration {
  id           String   @id @default(cuid())
  orgId        String?
  userId       String?
  kind         String // ideas | script | hooks | refine | packaging | patterns | report | signals | brief
  promptKey    String
  provider     String
  model        String
  status       String   @default("ok") // ok | error
  latencyMs    Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  error        String?
  entityType   String?
  entityId     String?
  createdAt    DateTime @default(now())
  /// AI-08: estimated cost in millionths of a US dollar, from configured
  /// prices; null when no price is configured (never guessed).
  costMicroUsd Int?
  /// Labelled mock output, never counted as model work.
  isDemo       Boolean  @default(false)
  /// The Brand Brain version in the context (AI-03).
  brainVersion Int?

  org  Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

