// Threadline OS — data model
//
// PORTABILITY CONTRACT (see docs/ARCHITECTURE.md ADR-001):
//   * No database enums    -> statuses are String, constrained by Zod unions in src/lib/domain
//   * No array columns     -> list values are JSON-encoded String, read via src/lib/db/json.ts
//   * No provider-specific types
// PostgreSQL since 26 September 2026 (ADR-001 amended). The SQLite migration history is preserved under
// prisma/legacy-sqlite/ and is not replayed; prisma/migrations starts from a PostgreSQL baseline.
// DATABASE_URL is the pooled runtime URL; DIRECT_URL is the direct connection used by migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity, tenancy and access
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  title        String?
  avatarHue    Int       @default(210)
  isSuperAdmin Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  /// Staff two-factor (SEC-08). The TOTP secret is sealed with the credential
  /// keyring (never stored in the clear); recovery codes are stored as hashes.
  mfaSecret         String?
  mfaEnabledAt      DateTime?
  /// Last accepted TOTP time step, so a code cannot be replayed.
  mfaLastStep       Int?
  mfaRecoveryHashes String    @default("[]")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions             Session[]
  memberships          Membership[]
  invitationsSent      Invitation[]            @relation("InvitationInviter")
  workAssignments      WorkAssignment[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  tasksAssigned        Task[]                  @relation("TaskAssignee")
  comments             Comment[]
  assetsUploaded       Asset[]
  ideasCreated         Idea[]
  scriptVersions       ScriptVersion[]
  contentAsEditor      ContentItem[]           @relation("ContentEditor")
  contentAsFounder     ContentItem[]           @relation("ContentFounder")
  contentApproved      ContentItem[]           @relation("ContentApprover")
  contentEvents        ContentEvent[]
  reportsGenerated     WeeklyReport[]
  aiGenerations        AiGeneration[]
  supportIssuesOwned   SupportIssue[]
  sopEdits             SopDocument[]
  runsCreated          IntelligenceRun[]
  signalDecisions      CandidateSignal[]
  diagnosesCreated     ConstraintDiagnosis[]
  milestonesSigned     InstallationMilestone[]
  proofRecorded        ProofPeriod[]
  readinessReviews     RecordingReadiness[]
  packagesApproved     PlatformPackage[]       @relation("PackageApprover")
  prospectsOwned       Prospect[]              @relation("ProspectOwner")
  wedgesOwned          MarketWedge[]           @relation("WedgeOwner")
  callsOwned           SalesCall[]             @relation("CallOwner")
  funnelReviews        FunnelReview[]          @relation("ReviewAuthor")
  trackedLinks         TrackedLink[]           @relation("LinkAuthor")
  examplesAdded        ResearchExample[]       @relation("ExampleAuthor")
  eventsRecorded       CommercialEvent[]       @relation("EventRecorder")
  contentRoots         ContentRoot[]           @relation("RootAuthor")
  expectationsAuthored ContentExpectation[]    @relation("ExpectationAuthor")
  diagnosesAuthored    ContentDiagnosis[]      @relation("DiagnosisAuthor")
  diagnosesApproved    ContentDiagnosis[]      @relation("DiagnosisApprover")
  correctionsAuthored  CorrectionEntry[]       @relation("CorrectionAuthor")
  oauthStatesStarted   OAuthState[]            @relation("OAuthInitiator")
  authTokens           AuthToken[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipHash    String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// Set when the second factor was verified for this session (SEC-08).
  mfaVerifiedAt DateTime?
  lastSeenAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// A tenant. `kind` = "client" for customer workspaces, "internal" for the Threadline team org.
model Organization {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  kind            String    @default("client")
  status          String    @default("active") // active | onboarding | paused | churned
  packageTier     String    @default("install") // install | operate | scale
  onboardingStage String    @default("not_started") // not_started | in_progress | complete
  industry        String?
  website         String?
  geography       String?
  timezone        String    @default("Europe/London")
  currency        String    @default("GBP")
  setupFee        Int       @default(0) // minor units
  /// Fee for one four-week service period, in minor units.
  ///
  /// Not a monthly fee: four-week periods produce thirteen invoices a year, not
  /// twelve. See src/lib/domain/service-period.ts.
  periodFee       Int       @default(0)
  healthScore     Int       @default(80)
  accentHex       String?
  modulesEnabled  String    @default("[]") // JSON string[]
  supportNotes    String?
  /// A dry-run workspace that exercises the real fulfilment path without being
  /// a real client. Excluded from every portfolio and proof aggregate, and
  /// labelled wherever it appears. See src/lib/domain/synthetic.ts.
  synthetic       Boolean   @default(false)
  startedAt       DateTime?
  lastActivityAt  DateTime?
  /// OFF-01: offboarding. Client access ends at accessEndsAt (after the export
  /// window); tenant data is deleted after retentionUntil unless on legal hold.
  offboardedAt    DateTime?
  accessEndsAt    DateTime?
  retentionUntil  DateTime?
  legalHold       Boolean   @default(false)
  /// AI-08: monthly AI spend ceiling in millionths of a US dollar; null = no ceiling.
  aiBudgetMicroUsd Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships          Membership[]
  invitations          Invitation[]
  engagements          Engagement[]
  workAssignments      WorkAssignment[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  tasks                Task[]
  brandBrain           BrandBrain?
  offers               Offer[]
  icpProfiles          IcpProfile[]
  proofItems           ProofItem[]
  competitors          Competitor[]
  researchItems        ResearchItem[]
  tags                 Tag[]
  patterns             Pattern[]
  ideas                Idea[]
  scripts              Script[]
  contentItems         ContentItem[]
  contentEvents        ContentEvent[]
  assets               Asset[]
  comments             Comment[]
  platformPackages     PlatformPackage[]
  socialAccounts       SocialAccount[]
  publishRecords       PublishRecord[]
  performanceSnapshots PerformanceSnapshot[]
  inquiries            Inquiry[]
  weeklyReports        WeeklyReport[]
  operatingMetrics     OperatingMetric[]
  integrations         Integration[]
  supportIssues        SupportIssue[]
  sopDocuments         SopDocument[]
  onboardingSession    OnboardingSession?
  aiGenerations        AiGeneration[]
  intelligenceRuns     IntelligenceRun[]
  runSources           RunSource[]
  candidateSignals     CandidateSignal[]
  diagnoses            ConstraintDiagnosis[]
  milestones           InstallationMilestone[]
  proofPeriods         ProofPeriod[]
  recordingReadiness   RecordingReadiness?
  trackedLinks         TrackedLink[]
  uploadSessions       UploadSession[]
  processingTasks      ProcessingTask[]
  effortEntries        EffortEntry[]
  inboundSources       InboundSource[]
  visitors             Visitor[]
  touchpoints          Touchpoint[]
  commercialEvents     CommercialEvent[]
  judgeVerdicts        JudgeVerdict[]

  proofPermission     ProofPermission?
  contentRoots        ContentRoot[]
  contentExpectations ContentExpectation[]
  contentDiagnoses    ContentDiagnosis[]
  corrections         CorrectionEntry[]
  credentials         Credential[]
  oauthStates         OAuthState[]

  @@index([kind, status])
  @@index([synthetic])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      String // super_admin | internal_operator | client_admin | client_member | editor
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  /// Client permission profiles layered on the role (TEAM-01): JSON array of
  /// admin | approver | contributor | viewer | commercial.
  profiles    String    @default("[]")
  /// active | suspended. A suspended member keeps history but has no access.
  status      String    @default("active")
  suspendedAt DateTime?
  /// The workspace owner: cannot be removed or demoted except by an explicit transfer.
  isOwner     Boolean   @default(false)
  /// A named expert whose voice Threadline writes in (TEAM-08).
  isExpert    Boolean   @default(false)
  /// primary | backup | null: the client contact for decisions.
  contactRole String?

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    String
  meta       String   @default("{}") // JSON
  createdAt  DateTime @default(now())

  org   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id        String    @id @default(cuid())
  orgId     String
  userId    String?
  kind      String // approval | recording | report | alert | system | pipeline | intelligence_brief
  title     String
  body      String?
  href      String?
  severity  String    @default("info") // info | success | warning | critical
  readAt    DateTime?
  createdAt DateTime  @default(now())
  /// NOT-01: the same event never notifies the same person twice.
  dedupeKey String?
  emailedAt DateTime?

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([userId, readAt])
  @@unique([userId, dedupeKey])
}

model Task {
  id             String    @id @default(cuid())
  orgId          String
  title          String
  description    String?
  kind           String // record | approve | upload | decide | review | ops
  audience       String    @default("client") // client | internal
  status         String    @default("open") // open | in_progress | done | dismissed
  priority       String    @default("medium") // low | medium | high | urgent
  dueDate        DateTime?
  assigneeId     String?
  entityType     String?
  entityId       String?
  estimateMin    Int?
  // Delivery Load. Filled in after the work, by whoever did it — the point is to
  // find the real delegation trigger from measured work rather than from a
  // revenue milestone somebody picked.
  /// Minutes of actual attention, excluding waiting.
  activeMinutes  Int?
  /// Minutes lost to waiting on somebody else. Kept separate because the two
  /// have completely different fixes.
  waitingMinutes Int?
  /// Cash paid out for this task, in minor units.
  costMinor      Int       @default(0)
  /// What this work turned out to be. See WORK_CLASSES.
  workClass      String?
  loadNote       String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([orgId, status, audience])
  @@index([orgId, dueDate])
}

// ---------------------------------------------------------------------------
// Brand Brain — the context layer
// ---------------------------------------------------------------------------

model BrandBrain {
  id           String   @id @default(cuid())
  orgId        String   @unique
  company      String   @default("{}") // JSON CompanyProfile
  founder      String   @default("{}") // JSON FounderProfile
  voice        String   @default("{}") // JSON VoiceProfile
  contentRules String   @default("{}") // JSON ContentRules
  completeness Int      @default(0)
  /// AI-03/ENG-04: bumped by a database trigger on every change to the four
  /// sections; each version's content is kept in BrandBrainVersion.
  version      Int      @default(1)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Offer {
  id              String   @id @default(cuid())
  orgId           String
  name            String
  isPrimary       Boolean  @default(false)
  priceMinor      Int      @default(0)
  currency        String   @default("GBP")
  priceModel      String   @default("one_off") // one_off | retainer | subscription | hybrid
  mechanism       String?
  outcome         String?
  differentiators String   @default("[]") // JSON string[]
  guarantees      String?
  ctas            String   @default("[]") // JSON string[]
  exclusions      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model IcpProfile {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  isPrimary      Boolean  @default(false)
  description    String?
  demographics   String?
  firmographics  String?
  pains          String   @default("[]") // JSON string[]
  desires        String   @default("[]") // JSON string[]
  objections     String   @default("[]") // JSON string[]
  triggers       String   @default("[]") // JSON string[]
  sophistication String   @default("moderate") // low | moderate | high
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model ProofItem {
  id          String   @id @default(cuid())
  orgId       String
  kind        String // testimonial | case_study | metric | screenshot | credential
  title       String
  body        String?
  source      String?
  metricLabel String?
  metricValue String?
  claimStatus String   @default("allowed") // allowed | needs_review | prohibited
  assetId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, kind])
}

// ---------------------------------------------------------------------------
// Market Radar
// ---------------------------------------------------------------------------

model Competitor {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  url         String?
  platforms   String   @default("[]") // JSON string[]
  positioning String?
  notes       String?
  threatLevel String   @default("medium") // low | medium | high
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  researchItems ResearchItem[]
  runSources    RunSource[]

  @@index([orgId])
}

model ResearchItem {
  id           String   @id @default(cuid())
  orgId        String
  kind         String // competitor_post | customer_language | question | objection | trend | content_example | offer_example | source
  title        String
  body         String?
  url          String?
  sourceName   String?
  author       String?
  platform     String?
  competitorId String?
  metrics      String   @default("{}") // JSON { views, likes, comments, ... }
  capturedAt   DateTime @default(now())
  collectedVia String   @default("manual") // manual | url | seed | adapter | run
  /// Source metadata preserved verbatim from collection:
  /// JSON { sourceType, collectedAt, adapter, author, ... }.
  sourceMeta   String   @default("{}")
  /// Stable fingerprint used to deduplicate evidence across intelligence runs.
  /// Nullable, so items captured by hand are never forced into a fingerprint.
  dedupeKey    String?
  runId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org            Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  competitor     Competitor?         @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  run            IntelligenceRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)
  tags           ResearchItemTag[]
  evidenceFor    PatternEvidence[]
  ideaLinks      IdeaEvidence[]
  candidateLinks CandidateEvidence[]

  @@unique([orgId, dedupeKey])
  @@index([orgId, kind])
  @@index([orgId, capturedAt])
  @@index([runId])
}

model Tag {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  kind      String   @default("theme") // theme | competitor | pain | objection | desire | hook | format | proof | trend | question | customer_language | cta | offer | breakout
  createdAt DateTime @default(now())

  org   Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items ResearchItemTag[]

  @@unique([orgId, name])
  @@index([orgId, kind])
}

model ResearchItemTag {
  researchItemId String
  tagId          String

  researchItem ResearchItem @relation(fields: [researchItemId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([researchItemId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Signal / Pattern engine
// ---------------------------------------------------------------------------

model Pattern {
  id             String    @id @default(cuid())
  orgId          String
  kind           String // outlier | pattern | hypothesis | test | learning
  title          String
  description    String?
  status         String    @default("open") // open | testing | validated | rejected | archived
  confidence     Int       @default(50) // 0-100
  impact         Int       @default(3) // 1-5
  effort         Int       @default(3) // 1-5
  score          Float     @default(0)
  nextExperiment String?
  detectedBy     String    @default("manual") // manual | performance_loop | ai | intelligence_run
  /// The run that produced this signal, when it came from an intelligence cycle.
  runId          String?
  /// The signal this one was derived from - an approved pattern that became a test.
  derivedFromId  String?
  /// Ranking position among the tests derived from one run. 0 = unranked.
  rank           Int       @default(0)
  /// What the test is read on, so it has a defined outcome rather than a vibe.
  successMetric  String?
  /// Written back by the performance and commercial loop, never by a model.
  feedbackNote   String?
  lastFeedbackAt DateTime?
  /// Client visibility. The ONLY stored visibility flag in the product: every
  /// other surface derives visibility from state that already exists (see
  /// src/lib/domain/visibility.ts). A signal is internal working thought until
  /// somebody decides the client should see it, and no existing status answers
  /// that question.
  /// internal | client_published
  visibility     String    @default("internal")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run         IntelligenceRun?  @relation(fields: [runId], references: [id], onDelete: SetNull)
  derivedFrom Pattern?          @relation("PatternDerivation", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derived     Pattern[]         @relation("PatternDerivation")
  evidence    PatternEvidence[]
  candidates  CandidateSignal[]
  ideas       Idea[]

  @@index([orgId, kind, status])
  @@index([runId])
  @@index([derivedFromId])
}

model PatternEvidence {
  id             String   @id @default(cuid())
  patternId      String
  researchItemId String?
  contentItemId  String?
  note           String?
  metricRef      String?
  createdAt      DateTime @default(now())

  pattern      Pattern       @relation(fields: [patternId], references: [id], onDelete: Cascade)
  researchItem ResearchItem? @relation(fields: [researchItemId], references: [id], onDelete: Cascade)
  contentItem  ContentItem?  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([patternId])
}

// ---------------------------------------------------------------------------
// Idea engine
// ---------------------------------------------------------------------------

model Idea {
  id               String   @id @default(cuid())
  orgId            String
  title            String
  concept          String?
  audience         String?
  painDesire       String?
  pillar           String?
  platform         String   @default("linkedin")
  format           String   @default("short_form")
  angle            String?
  hookConcept      String?
  objective        String?
  cta              String?
  commercialIntent String   @default("medium") // low | medium | high
  noveltyScore     Int      @default(50)
  relevanceScore   Int      @default(50)
  proofStrength    Int      @default(50)
  formatFit        Int      @default(50)
  priorityScore    Float    @default(0)
  status           String   @default("backlog") // backlog | shortlisted | approved | scripted | rejected | archived
  rationale        String?
  source           String   @default("manual") // manual | ai | learning | onboarding
  patternId        String?
  /// The thesis this idea serves. Null for ideas created before lineage
  /// existed, and for one-off ideas that have not earned a root yet.
  rootId           String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pattern      Pattern?       @relation(fields: [patternId], references: [id], onDelete: SetNull)
  root         ContentRoot?   @relation(fields: [rootId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  evidence     IdeaEvidence[]
  scripts      Script[]
  contentItems ContentItem[]

  intendedJob String  @default("authority") // discovery | authority | conversion
  requestId   String? // client-supplied idempotency key

  @@unique([orgId, requestId])
  @@index([orgId, status])
  @@index([orgId, priorityScore])
  @@index([rootId])
}

model IdeaEvidence {
  id             String  @id @default(cuid())
  ideaId         String
  researchItemId String
  note           String?

  idea         Idea         @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  researchItem ResearchItem @relation(fields: [researchItemId], references: [id], onDelete: Cascade)

  @@unique([ideaId, researchItemId])
}

// ---------------------------------------------------------------------------
// Script engine
// ---------------------------------------------------------------------------

model Script {
  id               String    @id @default(cuid())
  orgId            String
  ideaId           String?
  title            String
  scriptType       String    @default("short_form") // short_form | youtube | linkedin_video | educational | founder_pov | story | authority | case_study | objection | list | teardown | vsl
  platform         String    @default("linkedin")
  qaState          String    @default("ai_draft") // ai_draft | needs_fact_check | ready_to_record | approved
  estimatedSeconds Int       @default(60)
  currentVersion   Int       @default(1)
  claimsVerified   Boolean   @default(false)
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  org          Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  idea         Idea?           @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  versions     ScriptVersion[]
  contentItems ContentItem[]

  @@index([orgId, qaState])
}

model ScriptVersion {
  id            String   @id @default(cuid())
  scriptId      String
  version       Int
  hook          String
  altHooks      String   @default("[]") // JSON string[]
  body          String
  cta           String?
  filmingNotes  String?
  claims        String   @default("[]") // JSON Claim[] { text, status, note }
  contextUsed   String   @default("[]") // JSON string[] of context block keys
  changeSummary String?
  generatedBy   String   @default("human") // human | ai | ai_refine
  /// The Brand Brain version an AI draft was written against (AI-03).
  brainVersion  Int?
  createdById   String?
  createdAt     DateTime @default(now())

  script    Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([scriptId, version])
  @@index([scriptId])
}

// ---------------------------------------------------------------------------
// Production
// ---------------------------------------------------------------------------

model ContentItem {
  id            String    @id @default(cuid())
  orgId         String
  ideaId        String?
  scriptId      String?
  title         String
  selectedHook  String?
  stage         String    @default("raw") // raw | editing | in_review | changes_requested | approved | scheduled | live
  platform      String    @default("linkedin")
  format        String    @default("short_form")
  priority      String    @default("medium") // low | medium | high | urgent
  dueDate       DateTime?
  editorId      String?
  founderId     String?
  revisionCount Int       @default(0)
  /// The thesis this piece tests.
  rootId        String?
  /// Set when this piece was cut from another — a short from an interview, a
  /// LinkedIn text version of a video. A derivative is measured on its own but
  /// never counted as a separate source asset against the period's output.
  derivedFromId String?
  /// source | derivative | retest — `retest` marks a deliberate re-attempt at
  /// the same thesis after a diagnosis.
  lineageRole   String    @default("source")
  recordedAt    DateTime?
  approvedAt    DateTime?
  approvedById  String?
  liveAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  idea        Idea?              @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  script      Script?            @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  editor      User?              @relation("ContentEditor", fields: [editorId], references: [id], onDelete: SetNull)
  founder     User?              @relation("ContentFounder", fields: [founderId], references: [id], onDelete: SetNull)
  approvedBy  User?              @relation("ContentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  root        ContentRoot?       @relation(fields: [rootId], references: [id], onDelete: SetNull)
  derivedFrom ContentItem?       @relation("ContentDerivatives", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivatives ContentItem[]      @relation("ContentDerivatives")
  diagnoses   ContentDiagnosis[]

  assets          Asset[]
  events          ContentEvent[]
  packages        PlatformPackage[]
  publishRecords  PublishRecord[]
  inquiries       Inquiry[]
  patternEvidence PatternEvidence[]
  trackedLinks    TrackedLink[]
  touchpoints     Touchpoint[]

  intendedJob String @default("authority") // discovery | authority | conversion

  @@index([orgId, stage])
  @@index([orgId, dueDate])
  @@index([rootId])
  @@index([derivedFromId])
}

model ContentEvent {
  id            String   @id @default(cuid())
  orgId         String
  contentItemId String
  type          String // stage_change | comment | revision_requested | approved | asset_added | recorded | scheduled | published | metric_added
  fromStage     String?
  toStage       String?
  note          String?
  actorId       String?
  createdAt     DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contentItem ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  actor       User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([contentItemId, createdAt])
}

/// Unified library + production asset record.
model Asset {
  id            String   @id @default(cuid())
  orgId         String
  contentItemId String?
  category      String // raw_media | edited_media | script_doc | transcript | research_doc | testimonial | case_study | brand_asset | offer_doc | thumbnail | report
  title         String
  description   String?
  fileName      String?
  mimeType      String?
  sizeBytes     Int?
  storagePath   String?
  externalUrl   String?
  version       Int      @default(1)
  tags          String   @default("[]") // JSON string[]
  uploadedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contentItem ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  uploadedBy  User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  storageProvider String @default("local") // local | s3
  /// Media processing (FILE-05): none | queued | processing | ready | failed. Aggregated from ProcessingTask rows.
  processingState String @default("none")
  processingTasks ProcessingTask[]

  @@index([orgId, category])
  @@index([contentItemId])
}

model Comment {
  id         String   @id @default(cuid())
  orgId      String
  entityType String // content_item | idea | script | pattern | research_item
  entityId   String
  body       String
  kind       String   @default("comment") // comment | revision_request | approval_note
  timecodeMs Int?
  resolved   Boolean  @default(false)
  /// Operator-only note. Never returned by a client-scoped read.
  internal   Boolean  @default(false)
  /// The version of the thing the comment is about (script version, package or cut hash), so feedback on an old version is never mistaken for feedback on the current one.
  version    String?
  authorId   String?
  createdAt  DateTime @default(now())

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orgId, entityType, entityId])
  @@index([orgId, internal])
}

// ---------------------------------------------------------------------------
// Packaging and distribution
// ---------------------------------------------------------------------------

model PlatformPackage {
  id                String    @id @default(cuid())
  orgId             String
  contentItemId     String
  platform          String
  /// Long-form packaging works title-first: a working title carries the piece
  /// through production, and the final title is a separate decision taken once
  /// the edit exists. Short-form simply leaves the working title empty.
  workingTitle      String?
  title             String?
  caption           String?
  description       String?
  hashtags          String    @default("[]") // JSON string[]
  overlays          String    @default("[]") // JSON string[]
  thumbnailConcepts String    @default("[]") // JSON string[]
  ctaOptions        String    @default("[]") // JSON string[]
  clipOpportunities String    @default("[]") // JSON { label, startSec, endSec, rationale }[]
  repurposing       String?
  /// The chosen thumbnail: an Asset id, or an external URL.
  thumbnailRef      String?
  status            String    @default("draft") // draft | ready | approved
  approvedAt        DateTime?
  approvedById      String?
  generatedBy       String    @default("human") // human | ai
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contentItem    ContentItem     @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  approvedBy     User?           @relation("PackageApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  publishRecords PublishRecord[]

  @@unique([contentItemId, platform])
  @@index([orgId])
}

model SocialAccount {
  id            String   @id @default(cuid())
  orgId         String
  platform      String
  handle        String
  displayName   String?
  isConnected   Boolean  @default(false)
  integrationId String?
  createdAt     DateTime @default(now())

  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  integration    Integration?    @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  publishRecords PublishRecord[]

  @@index([orgId, platform])
}

model PublishRecord {
  id            String    @id @default(cuid())
  orgId         String
  contentItemId String
  packageId     String?
  accountId     String?
  platform      String
  status        String    @default("draft") // draft | ready | scheduled | published | failed
  method        String    @default("manual") // manual | integration
  scheduledFor  DateTime?
  publishedAt   DateTime?
  url           String?
  failureReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org          Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contentItem  ContentItem           @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  package      PlatformPackage?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  account      SocialAccount?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  snapshots    PerformanceSnapshot[]
  inquiries    Inquiry[]
  trackedLinks TrackedLink[]
  touchpoints  Touchpoint[]

  distributionMode String  @default("organic") // organic | paid_amplified
  externalId       String?
  providerStatus   String?
  providerPayload  String? // JSON — last provider response, secrets stripped

  @@index([orgId, status])
  @@index([orgId, scheduledFor])
  @@index([contentItemId])
}

// ---------------------------------------------------------------------------
// Performance and commercial pipeline
// ---------------------------------------------------------------------------

model PerformanceSnapshot {
  id              String   @id @default(cuid())
  orgId           String
  publishRecordId String
  capturedAt      DateTime @default(now())
  views           Int      @default(0)
  impressions     Int      @default(0)
  reach           Int      @default(0)
  likes           Int      @default(0)
  comments        Int      @default(0)
  shares          Int      @default(0)
  saves           Int      @default(0)
  watchTimeSec    Int      @default(0)
  avgViewSec      Float    @default(0)
  retentionPct    Float    @default(0)
  ctrPct          Float    @default(0)
  leads           Int      @default(0)
  bookedCalls     Int      @default(0)
  revenueMinor    Int      @default(0)
  source          String   @default("manual") // manual | adapter | seed
  createdAt       DateTime @default(now())

  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  publishRecord PublishRecord @relation(fields: [publishRecordId], references: [id], onDelete: Cascade)

  // Provenance for ingested rows. `providerRecordId` + `source` + `capturedAt` stop the same reading landing twice.
  providerRecordId String?
  fetchedAt        DateTime?
  provenance       String? // JSON: { provider, endpoint, requestedAt, fields: { views: "0"|"unknown"|"unavailable"|"unsupported"|"stale" } }
  unavailable      String    @default("[]") // JSON string[] of metric keys the provider could not supply

  @@unique([publishRecordId, source, providerRecordId, capturedAt])
  @@index([orgId, capturedAt])
  @@index([publishRecordId, capturedAt])
}

model Inquiry {
  id              String    @id @default(cuid())
  orgId           String
  name            String
  company         String?
  email           String?
  stage           String    @default("inquiry") // inquiry | qualified | call_booked | won | lost
  source          String    @default("content") // content | referral | outbound | other
  contentItemId   String?
  publishRecordId String?
  cta             String?
  leadMagnet      String?
  link            String?
  valueMinor      Int       @default(0)
  currency        String    @default("GBP")
  occurredAt      DateTime  @default(now())
  closedAt        DateTime?
  notes           String?
  // How strongly this signal is actually connected to the content. Organic
  // content does not have paid-advertising certainty and the product must not
  // imply that it does, so every commercial signal carries its own class.
  attribution     String    @default("qualitative_only")
  evidenceBasis   String    @default("client_reported") // measured | client_reported | unavailable
  evidenceSource  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// The anonymous journey this person arrived through, when one is known.
  visitorId String?

  /// Lead inbox (AI-06): where the lead came in, the key used to merge repeats,
  /// who owns the response, and when a person first replied.
  channel         String    @default("manual") // manual | email | website_form | linkedin_dm | x_dm | instagram_dm | phone | referral | other
  dedupeKey       String?
  ownerId         String?
  firstResponseAt DateTime?
  followUpAt      DateTime?
  /// JSON [{ criterion, note, by, at }]: what was actually established. Location alone never qualifies.
  qualification   String?
  messages        LeadMessage[]
  replyDrafts     ReplyDraft[]

  org           Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contentItem   ContentItem?      @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  publishRecord PublishRecord?    @relation(fields: [publishRecordId], references: [id], onDelete: SetNull)
  visitor       Visitor?          @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  events        CommercialEvent[]

  @@index([orgId, stage])
  @@index([orgId, occurredAt])
  @@index([orgId, dedupeKey])
}

// ---------------------------------------------------------------------------
// Reporting and operating metrics
// ---------------------------------------------------------------------------

model WeeklyReport {
  id            String   @id @default(cuid())
  orgId         String
  periodStart   DateTime
  periodEnd     DateTime
  status        String   @default("draft") // draft | final
  payload       String   @default("{}") // JSON WeeklyReportPayload
  narrative     String? // optional AI-written executive narrative
  generatedById String?
  generatedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// REP-01: each correction of a final report is a new version; a final
  /// version is never edited, and clients read the latest final one.
  version        Int       @default(1)
  supersedesId   String?
  revisionReason String?
  finalisedAt    DateTime?
  finalisedById  String?
  supersededAt   DateTime?

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  generatedBy User?        @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  @@unique([orgId, periodStart, version])
  @@index([orgId, periodStart])
}

/// The four-week review at the end of each service period (REP-02), in the
/// order ACTION, RESULTS, PROBLEMS, FUTURE. Figures are computed from records
/// and frozen; the operator writes the judgement. Versioned like reports.
model PeriodReview {
  id              String    @id @default(cuid())
  orgId           String
  engagementId    String
  periodNumber    Int
  periodStart     DateTime  @db.Date
  periodEnd       DateTime  @db.Date
  version         Int       @default(1)
  /// draft | final
  status          String    @default("draft")
  /// JSON: figures computed from the period's records.
  figures         String    @default("{}")
  action          String    @default("")
  results         String    @default("")
  problems        String    @default("")
  future          String    @default("")
  createdById     String?
  finalisedAt     DateTime?
  finalisedById   String?
  supersededAt    DateTime?
  revisionReason  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@unique([engagementId, periodNumber, version])
  @@index([orgId, periodStart])
}

model OperatingMetric {
  id                  String   @id @default(cuid())
  orgId               String
  weekStart           DateTime
  founderHours        Float    @default(0)
  hoursSaved          Float    @default(0)
  cycleTimeHours      Float    @default(0)
  approvalHours       Float    @default(0)
  piecesShipped       Int      @default(0)
  contractorCostMinor Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, weekStart])
  @@index([orgId, weekStart])
}

// ---------------------------------------------------------------------------
// Intelligence Run - the market intelligence cycle
// ---------------------------------------------------------------------------

/// One cycle of market intelligence: scope, collect, synthesise, human review,
/// ranked tests. A run is the unit a client reads as "what Threadline found in
/// your market this week, why it matters, and what we are doing because of it".
///
/// Invariant: a candidate signal cannot influence strategy until a human has
/// approved it. Enforced in src/lib/domain/intelligence.ts.
model IntelligenceRun {
  id            String    @id @default(cuid())
  orgId         String
  label         String
  periodStart   DateTime
  periodEnd     DateTime
  status        String    @default("scoping") // scoping | collecting | synthesis | review | published | archived
  /// The question this run was asked to answer.
  focus         String?
  /// Headline paragraph, written or edited by a human before publishing.
  summary       String?
  /// Frozen brief payload, written at publish time so a brief read months later
  /// shows what the client was actually sent (same rule as WeeklyReport).
  brief         String    @default("{}")
  evidenceCount Int       @default(0)
  signalCount   Int       @default(0)
  approvedCount Int       @default(0)
  testCount     Int       @default(0)
  publishedAt   DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sources    RunSource[]
  candidates CandidateSignal[]
  research   ResearchItem[]
  patterns   Pattern[]

  @@index([orgId, status])
  @@index([orgId, periodStart])
}

/// A declared input to a run.
///
/// Honesty rule: a source whose adapter cannot legitimately collect records
/// status "unavailable" with the specific blocker, and keeps its manual intake
/// path. Nothing here ever reports a connection that does not exist.
model RunSource {
  id             String    @id @default(cuid())
  orgId          String
  runId          String
  kind           String // competitor | creator | category | sales_call | customer_language | historic_content | performance | pipeline | url | note
  label          String
  url            String?
  competitorId   String?
  collectionMode String    @default("manual") // manual | url | adapter
  status         String    @default("pending") // pending | collected | unavailable | skipped
  /// Why an automatic collection is not available, in the operator's words.
  statusNote     String?
  /// Manually supplied material: call notes, transcript excerpts, pasted copy.
  content        String?
  itemsCollected Int       @default(0)
  collectedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run        IntelligenceRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  competitor Competitor?     @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([runId, status])
}

/// A proposed signal awaiting a human decision. Approving one creates a Pattern
/// in the existing signal engine and carries the evidence trail with it.
model CandidateSignal {
  id            String    @id @default(cuid())
  orgId         String
  runId         String
  kind          String // customer_language | pain | desire | objection | competitor_theme | content_outlier | recurring_hook | offer_shift | content_gap
  title         String
  rationale     String?
  /// Why this matters commercially, in plain language.
  soWhat        String?
  confidence    Int       @default(50) // 0-100
  decision      String    @default("pending") // pending | approved | rejected
  decisionNote  String?
  decidedById   String?
  decidedAt     DateTime?
  /// True once a human has changed the wording, so provenance stays truthful.
  editedByHuman Boolean   @default(false)
  /// Set when approved and promoted into the signal engine.
  patternId     String?
  generatedBy   String    @default("ai") // ai | operator
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org       Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run       IntelligenceRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  decidedBy User?               @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  pattern   Pattern?            @relation(fields: [patternId], references: [id], onDelete: SetNull)
  evidence  CandidateEvidence[]

  @@index([orgId, decision])
  @@index([runId, decision])
}

/// Join between a candidate signal and the evidence that produced it. A
/// candidate with no evidence cannot be created - see the run domain rules.
model CandidateEvidence {
  id                String   @id @default(cuid())
  candidateSignalId String
  researchItemId    String
  note              String?
  createdAt         DateTime @default(now())

  candidateSignal CandidateSignal @relation(fields: [candidateSignalId], references: [id], onDelete: Cascade)
  researchItem    ResearchItem    @relation(fields: [researchItemId], references: [id], onDelete: Cascade)

  @@unique([candidateSignalId, researchItemId])
  @@index([researchItemId])
}

// ---------------------------------------------------------------------------
// Constraint diagnosis
// ---------------------------------------------------------------------------

/// A structured read on what is actually limiting demand, so the operation does
/// not default to assuming that more content is always the answer.
model ConstraintDiagnosis {
  id                String    @id @default(cuid())
  orgId             String
  status            String    @default("draft") // draft | active | superseded
  /// One of the nine dimensions in src/lib/domain/diagnosis.ts.
  primaryConstraint String
  severity          String    @default("medium") // low | medium | high | critical
  confidence        Int       @default(50) // 0-100
  evidence          String?
  /// Why the constraint matters commercially, not just descriptively.
  commercialImpact  String?
  recommendedAction String?
  /// The next experiment that would move the constraint.
  experiment        String?
  reviewDate        DateTime?
  reviewedAt        DateTime?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org         Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assessments ConstraintAssessment[]

  @@index([orgId, status])
}

/// One dimension of a diagnosis. Rating runs 1 (severely constrained) to 5 (strong).
model ConstraintAssessment {
  id          String  @id @default(cuid())
  diagnosisId String
  dimension   String
  rating      Int     @default(3)
  note        String?
  evidence    String?

  diagnosis ConstraintDiagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  @@unique([diagnosisId, dimension])
}

// ---------------------------------------------------------------------------
// Installation milestones - the first-value flow
// ---------------------------------------------------------------------------

/// Stored overlay for the installation milestones.
///
/// Milestone completion is DERIVED from real workspace state wherever it can be
/// (see src/lib/domain/installation.ts); this table stores only what cannot be
/// derived: an explicit human sign-off, a blocker, a note and a target date.
model InstallationMilestone {
  id            String    @id @default(cuid())
  orgId         String
  key           String
  note          String?
  blockedReason String?
  signedOffAt   DateTime?
  signedOffById String?
  targetDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  signedOffBy User?        @relation(fields: [signedOffById], references: [id], onDelete: SetNull)

  @@unique([orgId, key])
  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Proof capture - baseline and monthly comparison
// ---------------------------------------------------------------------------

/// A measurement period. The baseline records how the operation ran BEFORE
/// Threadline, which only the client can report - nothing before the engagement
/// is observable from inside the product, so those fields are stored as
/// client-reported and are always labelled that way in the UI.
///
/// Figures the platform can observe (pieces published, cycle time, approval
/// time, inquiries, calls booked) are computed at read time from the workspace
/// rather than copied in here, so they cannot drift from the records.
model ProofPeriod {
  id          String   @id @default(cuid())
  orgId       String
  kind        String   @default("month") // baseline | month
  label       String
  periodStart DateTime
  periodEnd   DateTime

  reportedFounderHours           Float?
  reportedContentOutput          Int?
  reportedCycleTimeDays          Float?
  reportedApprovalDays           Float?
  reportedAudienceSize           Int?
  reportedEngagementRate         Float?
  reportedQualifiedInquiries     Int?
  reportedCallsBooked            Int?
  reportedAttributableValueMinor Int?

  /// How attribution was established for this period, in the operator's words.
  attributionNote  String?
  /// Notable qualitative outcomes: a named inbound, a partnership, a speaking slot.
  qualitativeNotes String?
  source           String    @default("client_reported") // client_reported | operator_recorded
  lockedAt         DateTime?
  recordedById     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  recordedBy User?        @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([orgId, kind, periodStart])
  @@index([orgId, periodStart])
}

// ---------------------------------------------------------------------------
// Recording readiness - installation QA for the client's recording setup
// ---------------------------------------------------------------------------

/// Whether this client can actually record usable footage, repeatably.
///
/// The first batch is where an installation succeeds or quietly fails, and a
/// bad room is not something the operating loop can fix downstream. This makes
/// it an explicit gate with three honest outcomes rather than an assumption.
///
/// Status is set by an operator from the individual checks. The suggestion is
/// computed (src/lib/domain/readiness.ts) but the call belongs to a person.
model RecordingReadiness {
  id             String    @id @default(cuid())
  orgId          String    @unique
  status         String    @default("not_assessed") // not_assessed | ready | ready_with_limitation | blocked
  /// Formats this client needs to produce. JSON string[]:
  /// vertical_short | horizontal_long
  formats        String    @default("[]")
  roomNotes      String?
  gearNotes      String?
  /// What the operator recommends doing about it, in plain language.
  recommendation String?
  /// The single next action the client must take. Surfaced to them when the
  /// setup is blocked or limited; null when nothing is required of them.
  clientAction   String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reviewedBy User?            @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  checks     ReadinessCheck[]

  @@index([status])
}

/// One dimension of the recording setup. Keys are defined in
/// src/lib/domain/readiness.ts. A check in state "blocked" prevents the overall
/// assessment from being marked ready.
model ReadinessCheck {
  id          String  @id @default(cuid())
  readinessId String
  key         String // audio | light | framing | background | focus_stability | repeatability | format
  state       String  @default("unknown") // unknown | ok | limitation | blocked
  note        String?

  readiness RecordingReadiness @relation(fields: [readinessId], references: [id], onDelete: Cascade)

  @@unique([readinessId, key])
}

// ---------------------------------------------------------------------------
// Integrations, internal ops, AI accountability
// ---------------------------------------------------------------------------

model Integration {
  id       String @id @default(cuid())
  orgId    String
  provider String // youtube | linkedin | instagram | tiktok | x | google_drive | dropbox | stripe | calendly | hubspot | gohighlevel | email | analytics
  status   String @default("not_configured") // not_configured | configured | error | disabled

  /// ---------------------------------------------------------------------
  /// CAPABILITY-GRANULAR STATE
  ///
  /// One green "Connected" badge is a lie on every one of these platforms. An
  /// account can be authenticated and still unable to publish publicly, or
  /// able to publish and unable to read a single metric. Each capability is
  /// tracked separately because each is gated separately in reality.
  /// ---------------------------------------------------------------------

  /// none | connected | expired | revoked | error
  authStatus String @default("none")

  /// unavailable | manual | native_delegated | api_private_only | api_public
  ///
  /// `api_private_only` is the state an unaudited TikTok app is in: the API
  /// accepts the post, returns success, and nobody can see it.
  publishCapability String @default("manual")

  /// unavailable | manual | api
  analyticsCapability String @default("manual")

  /// unavailable | manual | provider | api
  researchCapability String @default("unavailable")

  /// not_required | not_submitted | in_review | approved | rejected
  reviewStatus String @default("not_required")

  /// JSON string[]. Requested and granted are held apart because providers
  /// routinely grant a subset without saying so.
  scopesRequested String @default("[]")
  scopesGranted   String @default("[]")

  /// JSON string[] — plain-language limits currently in force, shown verbatim.
  restrictions String @default("[]")

  externalAccountId    String?
  externalAccountLabel String?

  tokenExpiresAt       DateTime?
  lastVerifiedAt       DateTime?
  lastSuccessfulSyncAt DateTime?
  lastErrorAt          DateTime?
  lastErrorCode        String?
  lastErrorMessage     String?
  /// Set when the token is gone and only the operator can fix it.
  reconnectRequired    Boolean   @default(false)
  /// How access to this provider actually works for this client:
  /// manual | native_delegated | api
  ///
  /// This exists so "configured" can never be read as "connected to an API".
  /// native_delegated means a person publishes from the client's own account
  /// under delegated access. Threadline holds no credential in either case.
  accessMethod         String    @default("manual")
  config               String    @default("{}") // JSON, non-secret configuration only
  notes                String?
  connectedAt          DateTime?
  lastSyncAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  accounts SocialAccount[]

  @@unique([orgId, provider])
}

model SupportIssue {
  id          String    @id @default(cuid())
  orgId       String?
  title       String
  description String?
  severity    String    @default("medium") // low | medium | high | critical
  status      String    @default("open") // open | investigating | blocked | resolved
  ownerId     String?
  resolution  String?
  becomesSop  Boolean   @default(false)
  becomesFix  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  org   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([status, severity])
}

/// Internal SOP / knowledge documents. orgId null = global Threadline SOP.
model SopDocument {
  id          String   @id @default(cuid())
  orgId       String?
  key         String
  title       String
  category    String   @default("delivery") // sales | delivery | research | production | account | support
  summary     String?
  body        String   @default("")
  version     Int      @default(1)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  updatedBy User?         @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([key])
  @@index([category])
}

model OnboardingSession {
  id             String    @id @default(cuid())
  orgId          String    @unique
  currentStep    String    @default("welcome")
  completedSteps String    @default("[]") // JSON string[]
  data           String    @default("{}") // JSON OnboardingData
  status         String    @default("in_progress") // in_progress | building | complete
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// Inbound applications from the public marketing site. Intentionally has no orgId.
model Application {
  id                String   @id @default(cuid())
  name              String
  email             String
  company           String
  website           String?
  whatYouSell       String
  revenueRange      String
  contentProcess    String
  peopleInvolved    String
  publishCadence    String
  biggestBottleneck String
  founderHours      String
  platforms         String   @default("[]") // JSON string[]
  successLooksLike  String
  urgency           String
  extra             String?
  status            String   @default("new") // new | reviewing | call_booked | accepted | declined
  reviewNotes       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  role             String?
  typicalDealValue Int? // minor units, disclosed by the applicant
  acquisitionToday String?
  capacityNote     String?
  prospectId       String?
  prospect         Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  /// Qualification (COM-02): who at Threadline owns it and what happens next.
  ownerId             String?
  nextAction          String?
  nextActionDue       DateTime?
  /// won | lost | not_a_fit | no_response | null while open
  outcome             String?
  outcomeReason       String?
  /// Set when converted into a client workspace (COM-03).
  orgId               String?
  convertedAt         DateTime?
  confirmationQueuedAt DateTime?
  operatorNotifiedAt  DateTime?

