# ---------------------------------------------------------------------------
# Threadline OS — environment
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# REQUIRED. PostgreSQL. DATABASE_URL is the pooled URL the app uses; DIRECT_URL
# is the unpooled URL migrations use (with Neon: the -pooler host and the plain
# host). Locally, `npm run db:local` starts an embedded PostgreSQL and
# `npm run db:local:url` prints its URL.
DATABASE_URL="postgresql://user:password@localhost:5432/threadline?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/threadline?schema=public"

# OPTIONAL. production | preview | development | test. On Vercel VERCEL_ENV is
# used when this is unset. Only production sends email, publishes or bills.
APP_ENV=""

# REQUIRED in production. Protects /api/cron (Vercel Cron sends it as a bearer token).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""

# OPTIONAL. Sentry-format DSN for error reporting (Sentry, GlitchTip, ...).
ERROR_REPORTING_DSN=""

# Self-hosting only (not Vercel): how many proxies sit in front of the app, so
# the client IP is read from the right place in X-Forwarded-For.
TRUSTED_PROXY_HOPS=""

# REQUIRED in production. Public origin, used for absolute links in reports and emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OPTIONAL. Anthropic API key. When absent, the AI layer runs the deterministic mock
# provider and every generation is visibly labelled "Demo generation" in the UI.
# Obtain from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# OPTIONAL. Model used for generation. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL="claude-sonnet-5"

# OPTIONAL. External booking URL used by the application flow's final step.
# Any scheduling provider works; no credentials required.
NEXT_PUBLIC_BOOKING_URL=""

# REQUIRED before connecting any social account. Encrypts OAuth tokens at rest.
#
# One or more `id:base64key` pairs, newest first, comma separated. Each key must
# be exactly 32 bytes. Rotate by prepending a new entry and keeping the old one
# so existing credentials stay readable:
#
#   CREDENTIAL_ENCRYPTION_KEYS="2026-09:NEW...,2026-03:OLD..."
#
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Threadline refuses to store a token it cannot encrypt. Leaving this empty
# keeps every integration on the manual route rather than storing secrets in
# plaintext.
CREDENTIAL_ENCRYPTION_KEYS=""

# OPTIONAL. Local filesystem root for uploaded assets. Defaults to ./storage
STORAGE_ROOT="./storage"

# OPTIONAL. Password used for the seeded demo accounts. Defaults to a documented
# development value; set this before seeding any shared environment.
SEED_DEMO_PASSWORD=""
# The demo seed wipes all organisations and users first. It refuses unless this
# is exactly "wipe-local-demo-data", the database is local and holds only demo data.
SEED_CONFIRM_RESET=""

# ---------------------------------------------------------------------------
# Completion pass (2026-09-09) — email, jobs, storage, rate limit, connectors,
# webhooks. Every variable is optional in development; each one that is unset
# leaves the feature in its truthful "not configured" state, never a fake.
# ---------------------------------------------------------------------------

# EMAIL. "capture" (default) stores rendered mail in the EmailMessage table and
# sends nothing — the UI shows the invite/reset link directly. "resend" delivers
# through Resend's HTTP API.
EMAIL_PROVIDER="capture"
RESEND_API_KEY=""
EMAIL_FROM="Threadline <no-reply@example.test>"

# BACKGROUND JOBS. The queue is the database; run `npm run jobs:worker` (or a
# scheduled `--once`) alongside the app. Poll interval in milliseconds.
JOBS_POLL_MS="5000"

# OBJECT STORAGE. "local" (default) writes under STORAGE_ROOT. "s3" needs all
# five S3_* values and refuses to start half-configured. Works with AWS S3,
# Cloudflare R2, MinIO and Backblaze (path-style by default).
STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# SHARED RATE LIMIT. "memory" (default) is per-instance. "redis" uses an
# Upstash-compatible REST endpoint and FAILS CLOSED if it cannot be reached;
# set RATE_LIMIT_FAIL_OPEN=true only if availability must beat abuse control.
RATE_LIMIT_STORE="memory"
RATE_LIMIT_REDIS_URL=""
RATE_LIMIT_REDIS_TOKEN=""
RATE_LIMIT_FAIL_OPEN="false"

# PLATFORM CONNECTORS. Client credentials from each developer console. Absent
# = "credentials missing" in the integrations UI; present = the OAuth flow can
# start. Platform review / access tiers are separate gates documented in
# docs/PLATFORM_APPLICATIONS.md.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_APP_AUDITED="false"
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# WEBHOOKS. No environment variable: each workspace stores its provider
# webhook secret encrypted (Credential purpose "webhook_secret") and registers
# POST /api/webhooks/{provider}?org={orgId} with the provider.

# HEADLESS QA. Optional path to Chrome for the browser/public/visual suites.
CHROME_PATH=""
QA_BASE="http://localhost:3000"

# OPTIONAL. Where new-application alerts go (Threadline's own inbox).
OPS_NOTIFY_EMAIL=""

# OPTIONAL. Threadline's own CRM (Attio). Writes happen only in production.
ATTIO_API_KEY=""
# JSON map of Threadline stages to your Attio deal stage names, if they differ from Attio's defaults.
ATTIO_STAGE_MAP=""
