# ---------------------------------------------------------------------------
# Threadline OS — environment
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# REQUIRED. Database connection.
# SQLite (default, zero setup):
DATABASE_URL="file:./dev.db"
# PostgreSQL (change `provider` to "postgresql" in prisma/schema.prisma first):
# DATABASE_URL="postgresql://user:password@localhost:5432/threadline?schema=public"

# REQUIRED in production. 32+ random bytes, used to sign/derive session material.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# REQUIRED in production. Public origin, used for absolute links in reports and emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OPTIONAL. Anthropic API key. When absent, the AI layer runs the deterministic mock
# provider and every generation is visibly labelled "Demo generation" in the UI.
# Obtain from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# OPTIONAL. Model used for generation. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL="claude-sonnet-5"

# OPTIONAL. External booking URL used by the application flow's final step.
# Any scheduling provider works; no credentials required.
NEXT_PUBLIC_BOOKING_URL=""

# REQUIRED before connecting any social account. Encrypts OAuth tokens at rest.
#
# One or more `id:base64key` pairs, newest first, comma separated. Each key must
# be exactly 32 bytes. Rotate by prepending a new entry and keeping the old one
# so existing credentials stay readable:
#
#   CREDENTIAL_ENCRYPTION_KEYS="2026-09:NEW...,2026-03:OLD..."
#
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Threadline refuses to store a token it cannot encrypt. Leaving this empty
# keeps every integration on the manual route rather than storing secrets in
# plaintext.
CREDENTIAL_ENCRYPTION_KEYS=""

# OPTIONAL. Local filesystem root for uploaded assets. Defaults to ./storage
STORAGE_ROOT="./storage"

# OPTIONAL. Password used for the seeded demo accounts. Defaults to a documented
# development value; set this before seeding any shared environment.
SEED_DEMO_PASSWORD=""
