"use client";

import { useRouter } from "next/navigation";
import { Check } from "lucide-react";
import { Card, CardBody, CardFooter, CardHeader } from "@/components/ui/card";
import { Field } from "@/components/ui/field";
import { Input, NativeSelect, Textarea } from "@/components/ui/input";
import { ActionForm, FormError, SubmitButton } from "@/components/forms/action-form";
import { updateClientAction } from "@/lib/actions/admin";
import { ORG_STATUS_OPTIONS, PACKAGE_TIER_OPTIONS } from "@/lib/domain/enums";

export function ClientConfigForm({
  orgId,
  defaults,
  currency,
}: {
  orgId: string;
  defaults: {
    name: string;
    status: string;
    packageTier: string;
    website: string;
    industry: string;
    geography: string;
    setupFee: number;
    periodFee: number;
    supportNotes: string;
    accentHex: string;
  };
  currency: string;
}) {
  const router = useRouter();

  return (
    <ActionForm action={updateClientAction.bind(null, orgId)} onSuccess={() => router.refresh()}>
      {({ fieldErrors, error }) => (
        <Card>
          <CardHeader
            title="Configuration"
            eyebrow="Managed by Threadline"
            description="What the client cannot change themselves."
          />
          <CardBody className="space-y-5 pt-0">
            <FormError error={error} />

            <div className="grid gap-5 sm:grid-cols-2">
              <Field label="Client name" htmlFor="clientName" error={fieldErrors.name}>
                <Input id="clientName" name="name" defaultValue={defaults.name} required />
              </Field>
              <Field label="Status" htmlFor="clientStatus">
                <NativeSelect id="clientStatus" name="status" defaultValue={defaults.status}>
                  {ORG_STATUS_OPTIONS.map((o) => (
                    <option key={o.value} value={o.value}>
                      {o.label}
                    </option>
                  ))}
                </NativeSelect>
              </Field>
              <Field label="Package" htmlFor="clientPackage">
                <NativeSelect
                  id="clientPackage"
                  name="packageTier"
                  defaultValue={defaults.packageTier}
                >
                  {PACKAGE_TIER_OPTIONS.map((o) => (
                    <option key={o.value} value={o.value}>
                      {o.label}
                    </option>
                  ))}
                </NativeSelect>
              </Field>
              <Field label="Website" htmlFor="clientWebsite" optional>
                <Input id="clientWebsite" name="website" defaultValue={defaults.website} />
              </Field>
              <Field label="Industry" htmlFor="clientIndustry" optional>
                <Input id="clientIndustry" name="industry" defaultValue={defaults.industry} />
              </Field>
              <Field label="Geography" htmlFor="clientGeography" optional>
                <Input id="clientGeography" name="geography" defaultValue={defaults.geography} />
              </Field>
              <Field label={`Setup fee (${currency})`} htmlFor="clientSetupFee">
                <Input
                  id="clientSetupFee"
                  name="setupFee"
                  type="number"
                  min={0}
                  step="0.01"
                  defaultValue={defaults.setupFee}
                />
              </Field>
              <Field label={`Monthly fee (${currency})`} htmlFor="clientMonthlyFee">
                <Input
                  id="clientMonthlyFee"
                  name="periodFee"
                  type="number"
                  min={0}
                  step="0.01"
                  defaultValue={defaults.periodFee}
                />
              </Field>
            </div>

            <Field
              label="Accent colour"
              htmlFor="accentHex"
              hint="Optional per-client accent. Leave blank to use the Threadline champagne."
              error={fieldErrors.accentHex}
              optional
            >
              <Input
                id="accentHex"
                name="accentHex"
                defaultValue={defaults.accentHex}
                placeholder="#C8A96B"
                pattern="#[0-9a-fA-F]{6}"
              />
            </Field>

            <Field
              label="Support notes"
              htmlFor="supportNotes"
              hint="Internal only. Preferences, constraints, anything an operator should know before contacting them."
              optional
            >
              <Textarea
                id="supportNotes"
                name="supportNotes"
                defaultValue={defaults.supportNotes}
                rows={4}
              />
            </Field>
          </CardBody>
          <CardFooter>
            <span className="text-[12px] text-faint">
              Visible to Threadline staff. The client sees status and package only.
            </span>
            <SubmitButton variant="primary" icon={Check}>
              Save configuration
            </SubmitButton>
          </CardFooter>
        </Card>
      )}
    </ActionForm>
  );
}
