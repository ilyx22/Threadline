{
  "name": "threadline-os",
  "version": "1.0.0",
  "private": true,
  "description": "Threadline OS — the operating system behind founder-led content.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run seed",
    "db:studio": "prisma studio",
    "seed": "tsx --conditions=react-server prisma/seed.ts",
    "setup": "prisma migrate deploy && prisma generate && npm run seed",
    "test": "tsx --conditions=react-server --test --test-reporter=spec \"src/**/*.test.ts\"",
    "verify:features": "tsx --conditions=react-server scripts/verify-features.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run verify:features",
    "qa:all": "node scripts/qa/run.cjs run-all",
    "qa:spine": "node scripts/qa/run.cjs suite-core-spine",
    "qa:browser": "node scripts/qa/run.cjs browser-qa",
    "qa:perf": "node scripts/qa/run.cjs perf-smoke"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@prisma/client": "^6.18.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "prisma": "^6.18.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
